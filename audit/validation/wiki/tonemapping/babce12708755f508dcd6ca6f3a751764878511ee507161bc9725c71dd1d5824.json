  "claims": [
    {
      "claim_id": "tone-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-tone-mapping",
          "evidence_id": "evidence-0682d4015b96"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-0682d4015b96",
          "exact": "Tone mapping is a technique used in image processing and computer graphics to map one set of colors to another to approximate the appearance of high-dynamic-range (HDR) images in a medium that has a more limited dynamic range."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-0682d4015b96",
          "subject": "tone mapping",
          "predicate": "is defined as",
          "object": "a technique to map one set of colors to another to approximate the appearance of HDR images in a medium with a more limited dynamic range",
          "qualifiers": {
            "context": "image processing and computer graphics"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "目标引文（[0,226]，evidence-0682d4015b96）原文为：Tone mapping 是把一组颜色映射到另一组、以在动态范围更有限的媒介上近似显示高动态范围（HDR）图像外观的技术（'map one set of colors to another to approximate the appearance of high-dynamic-range (HDR) images in a medium that has a more limited dynamic range'），与 claim 的「把一组颜色映射到另一组」「在动态范围更有限的媒介上近似显示 HDR 图像外观」「技术」逐项对应。claim 仅省略了 'used in image processing and computer graphics' 这一领域背景限定，未改变或添加任何断言内容，翻译忠实，引文直接支持该 claim。独立性：target 的 provenance 为空对象，引文亦无转载/来源声明，无法举证独立性，输出 independence_unknown。",
      "rationale_offsets": [
        {
          "source_id": "wiki-tone-mapping",
          "evidence_id": "evidence-0682d4015b96",
          "start": 0,
          "end": 226
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "tone-local-ops",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-tone-mapping",
          "evidence_id": "evidence-cb52956d0035"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-cb52956d0035",
          "exact": "Local (or spatially varying) operators: the parameters of the non-linear function change in each pixel, according to features extracted from the surrounding parameters. In other words, the effect of the algorithm changes in each pixel according to the local features of the image. Those algorithms are more complicated than the global ones; they can show artifacts (e.g. halo effect and ringing); and the output can look unrealistic, but they can (if used correctly) provide the best performance, since human vision is mainly sensitive to local contrast."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-cb52956d0035",
          "subject": "local (spatially varying) tone mapping operators",
          "predicate": "are characterized by",
          "object": "per-pixel changing non-linear function parameters based on local image features, being more complicated than global ones, showing artifacts (halo effect, ringing), and providing the best performance since human vision is mainly sensitive to local contrast",
          "qualifiers": {
            "conditional": "if used correctly"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "目标引文（[0,555]，evidence-cb52956d0035）逐句对应 claim：①'the parameters of the non-linear function change in each pixel, according to features extracted from the surrounding parameters' 与 'changes in each pixel according to the local features of the image' →「非线性函数参数随像素局部特征逐像素变化」；②'more complicated than the global ones' →「比全局算子复杂」；③'can show artifacts (e.g. halo effect and ringing)' →「可能产生 halo（光晕）与振铃伪影」；④'can (if used correctly) provide the best performance, since human vision is mainly sensitive to local contrast' →「能提供最佳性能——因为人眼主要对局部对比敏感」。claim 把 'can...provide' 的条件式表述为「能提供」，与引文语义一致（未断言必然性，且引文本身的 'can' 即表可能），未夸大；其余为忠实转述。引文完全支持该 claim。独立性：provenance 为空，无法举证，输出 independence_unknown。",
      "rationale_offsets": [
        {
          "source_id": "wiki-tone-mapping",
          "evidence_id": "evidence-cb52956d0035",
          "start": 0,
          "end": 555
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "tone-reinhard",
      "verdict": "supported",
      "targets": [

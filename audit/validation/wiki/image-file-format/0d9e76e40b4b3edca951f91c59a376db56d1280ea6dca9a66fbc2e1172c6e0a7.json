    {
      "claim_id": "raw-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-c499a5131665"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-c499a5131665",
          "exact": "A camera raw image file is a file that contains unprocessed data straight from a digital camera. Such data can later be changed into a photo, either within a digital camera itself or by usage of external tools. Raw files are so named because they are not yet processed, and contain large amounts of potentially redundant data."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-c499a5131665",
          "subject": "camera raw image file",
          "predicate": "contains and is named because",
          "object": "unprocessed data straight from a digital camera; not yet processed; large amounts of potentially redundant data"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[0,326)直接说明相机 RAW 文件包含相机直出的未处理数据，且因尚未处理而得名，并包含大量可能冗余的数据，完整覆盖 claim。",
      "rationale_offsets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-c499a5131665",
          "start": 0,
          "end": 326
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "raw-sensor-data",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-a67ba30f551a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-a67ba30f551a",
          "exact": "Raw files thus contain the full dynamic range (typically 12- or 14-bit) data as read out from each of the camera's image sensor pixels."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-a67ba30f551a",
          "subject": "Raw files",
          "predicate": "contain",
          "object": "full dynamic range, typically 12- or 14-bit, data read out from each camera image sensor pixel"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[0,135)直接支持 RAW 文件包含每个相机图像传感器像素读出的完整动态范围数据，并给出通常 12 或 14 位限定。",
      "rationale_offsets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-a67ba30f551a",
          "start": 0,
          "end": 135
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "raw-cfa",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-e17f2ae0d40a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-e17f2ae0d40a",
          "exact": "The camera's sensor is almost invariably overlaid with a color filter array (CFA), usually a Bayer filter, consisting of a mosaic of a 2x2 matrix of red, green, blue and (second) green filters."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-e17f2ae0d40a",
          "subject": "camera sensor",
          "predicate": "is almost invariably overlaid with",
          "object": "a CFA, usually Bayer, consisting of a 2x2 red, green, blue and second green filter mosaic"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[0,193)直接支持相机传感器几乎都覆有 CFA，通常是 Bayer 滤色阵，并说明其由 2x2 红、绿、蓝、第二个绿滤镜马赛克构成。",

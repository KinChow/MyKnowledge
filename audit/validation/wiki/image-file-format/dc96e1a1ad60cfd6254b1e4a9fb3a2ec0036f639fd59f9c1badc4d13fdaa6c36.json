        "basis": []
      }
    },
    {
      "claim_id": "raw-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-c499a5131665"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-c499a5131665",
          "exact": "A camera raw image file is a file that contains unprocessed data straight from a digital camera. Such data can later be changed into a photo, either within a digital camera itself or by usage of external tools. Raw files are so named because they are not yet processed, and contain large amounts of potentially redundant data."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-c499a5131665",
          "subject": "camera raw image file",
          "predicate": "is",
          "object": "a file containing unprocessed data straight from a digital camera; named because not yet processed; contains potentially redundant data",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文（[0,326]）逐项覆盖 claim：RAW 文件含相机直出的未处理数据（\"unprocessed data straight from a digital camera\"）、因尚未处理而得名（\"so named because they are not yet processed\"）、含大量可能冗余的数据（\"large amounts of potentially redundant data\"）。中英文逐项对应，判为 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-c499a5131665",
          "start": 0,
          "end": 326
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "raw-sensor-data",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-a67ba30f551a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-a67ba30f551a",
          "exact": "Raw files thus contain the full dynamic range (typically 12- or 14-bit) data as read out from each of the camera's image sensor pixels."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-a67ba30f551a",
          "subject": "raw files",
          "predicate": "contain",
          "object": "the full dynamic range (typically 12- or 14-bit) data read out from each image sensor pixel",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文（[0,135]）完整表述 claim：RAW 文件包含从相机图像传感器每个像素读出的完整动态范围数据（通常 12 或 14 位），与 claim 的每个要素（完整动态范围、通常 12/14 位、每个像素）一一对应，判为 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-a67ba30f551a",
          "start": 0,
          "end": 135
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "raw-cfa",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-e17f2ae0d40a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-e17f2ae0d40a",
          "exact": "The camera's sensor is almost invariably overlaid with a color filter array (CFA), usually a Bayer filter, consisting of a mosaic of a 2x2 matrix of red, green, blue and (second) green filters."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-e17f2ae0d40a",
          "subject": "camera sensor",
          "predicate": "is overlaid with",
          "object": "a color filter array (CFA), usually a Bayer filter, a mosaic of a 2x2 matrix of red, green, blue and (second) green filters",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文（[0,193]）完整支撑 claim：\"almost invariably\" 对应\"几乎都\"，\"color filter array (CFA), usually a Bayer filter\" 对应 CFA（通常 Bayer 滤色阵），\"a mosaic of a 2x2 matrix of red, green, blue and (second) green filters\" 对应 2×2 红/绿/蓝/（第二个）绿滤镜马赛克。判为 supported。",
      "rationale_offsets": [
        {

  "claims": [
    {
      "claim_id": "image-format-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-image-file-format",
          "evidence_id": "evidence-adc91f5255c3"
        },
        {
          "source_id": "wiki-image-file-format",
          "evidence_id": "evidence-3c749bf8166a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-adc91f5255c3",
          "exact": "An image file format is a file format for a digital image. There are many formats that can be used, such as JPEG, PNG, and GIF."
        },
        {
          "evidence_id": "evidence-3c749bf8166a",
          "exact": "The data stored in an image file format may be compressed or uncompressed. If the data is compressed, it may be done so using lossy compression or lossless compression."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-adc91f5255c3",
          "subject": "image file format",
          "predicate": "is defined as",
          "object": "a file format for a digital image, with examples such as JPEG, PNG, and GIF",
          "qualifiers": {}
        },
        {
          "evidence_id": "evidence-3c749bf8166a",
          "subject": "data stored in an image file format",
          "predicate": "may be",
          "object": "compressed or uncompressed; when compressed, using lossy or lossless compression",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文1（[0,127]）直接给出图像文件格式即数字图像的文件格式，并列举 JPEG、PNG、GIF 示例；引文2（[0,168]）说明其中存储的数据可压缩或未压缩，且压缩区分有损与无损。两条引文共同完整覆盖 claim 的定义、示例与压缩类型全部断言，无矛盾，判为 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-image-file-format",
          "evidence_id": "evidence-adc91f5255c3",
          "start": 0,
          "end": 127
        },
        {
          "source_id": "wiki-image-file-format",
          "evidence_id": "evidence-3c749bf8166a",
          "start": 0,
          "end": 168
        }
      ],
      "advisory": false,
      "independence": {

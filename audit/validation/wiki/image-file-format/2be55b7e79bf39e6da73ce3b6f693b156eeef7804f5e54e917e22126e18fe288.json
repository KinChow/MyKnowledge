    {
      "claim_id": "raw-cfa",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-e17f2ae0d40a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-e17f2ae0d40a",
          "exact": "The camera's sensor is almost invariably overlaid with a color filter array (CFA), usually a Bayer filter, consisting of a mosaic of a 2x2 matrix of red, green, blue and (second) green filters."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-e17f2ae0d40a",
          "subject": "the camera's sensor",
          "predicate": "is almost invariably overlaid with",
          "object": "a color filter array (CFA), usually a Bayer filter, a mosaic of a 2x2 matrix of red, green, blue and (second) green filters"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "目标证据（[0,193)）完整对应 claim 全部要素：\"almost invariably\"对应\"几乎都\"、\"color filter array (CFA), usually a Bayer filter\"对应\"滤色阵列（CFA，通常是 Bayer 滤色阵）\"、\"mosaic of a 2x2 matrix of red, green, blue and (second) green filters\"对应\"由 2×2 的红/绿/蓝/（第二个）绿滤镜构成的马赛克\"。逐项覆盖，无缺失或矛盾。",

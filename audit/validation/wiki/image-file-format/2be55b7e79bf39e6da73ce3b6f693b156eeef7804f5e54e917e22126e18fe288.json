    {
      "claim_id": "raw-sensor-data",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-a67ba30f551a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-a67ba30f551a",
          "exact": "Raw files thus contain the full dynamic range (typically 12- or 14-bit) data as read out from each of the camera's image sensor pixels."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-a67ba30f551a",
          "subject": "raw files",
          "predicate": "contain",
          "object": "the full dynamic range (typically 12- or 14-bit) data as read out from each of the camera's image sensor pixels"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "目标证据（[0,135)）逐项对应 claim：\"full dynamic range\"对应\"完整动态范围\"、\"(typically 12- or 14-bit)\"对应\"（通常 12 或 14 位）\"、\"data as read out from each of the camera's image sensor pixels\"对应\"传感器每个像素读出的...数据\"。语义完全一致，无缺失或过度声明。",
      "rationale_offsets": [
        {

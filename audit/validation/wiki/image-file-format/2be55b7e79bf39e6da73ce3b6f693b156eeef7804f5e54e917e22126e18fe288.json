        "basis": []
      }
    },
    {
      "claim_id": "raw-definition",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-raw-image-format",
          "evidence_id": "evidence-d813a0bd77e4"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d813a0bd77e4",
          "exact": "A camera raw image file is a file that contains unprocessed data straight from a digital camera."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d813a0bd77e4",
          "subject": "a camera raw image file",
          "predicate": "is",
          "object": "a file that contains unprocessed data straight from a digital camera"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "目标证据（[0,96)）仅支持 claim 前半部分：raw 文件是含相机直出未处理数据的文件。claim 中\"因尚未处理而得名\"（命名缘由）与\"含大量可能冗余的数据\"（数据冗余性）两个断言在该引文中没有对应文本——引文未提及命名来源，也未暗示数据存在冗余；缺失部分未被引文反驳，故为部分支持而非矛盾。",
      "rationale_offsets": [
        {
          "source_id": "wiki-raw-image-format",

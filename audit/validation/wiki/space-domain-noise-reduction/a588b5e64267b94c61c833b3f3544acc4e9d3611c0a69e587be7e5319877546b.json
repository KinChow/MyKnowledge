  "claims": [
    {
      "claim_id": "noise-tradeoff",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-04c098537dac"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-04c098537dac",
          "exact": "There are many noise reduction algorithms in image processing. In selecting a noise reduction algorithm, one must weigh several factors: the available computer power and time available; whether sacrificing some real detail is acceptable if it allows more noise to be removed; and the characteristics of the noise and the detail in the image, to better make those decisions."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-04c098537dac",
          "subject": "noise reduction algorithm selection",
          "predicate": "requires weighing",
          "object": "available computer power and time, acceptable detail sacrifice for more denoising, and characteristics of noise and image detail"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "target 引文 63-373 明确列出选择降噪算法时需权衡可用算力与时间、是否接受牺牲真实细节以去除更多噪声、以及噪声和图像细节特性，支持 claim。独立性无法从空 provenance 或引文原文举证。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-04c098537dac",
          "start": 63,
          "end": 373
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "noise-nlm",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-b1196b6868bf"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-b1196b6868bf",
          "exact": "Another approach for removing noise is based on non-local averaging of all the pixels in an image. In particular, the amount of weighting for a pixel is based on the degree of similarity between a small patch centered on that pixel and the small patch centered on the pixel being de-noised."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-b1196b6868bf",
          "subject": "noise removal approach",
          "predicate": "is based on",
          "object": "non-local averaging of all pixels; pixel weighting based on patch similarity"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "target 引文 0-98 说明该去噪方法基于图像所有像素的非局部平均，99-290 说明像素权重由该像素小块与被去噪像素小块的相似度决定，支持 claim。独立性无法从空 provenance 或引文原文举证。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",

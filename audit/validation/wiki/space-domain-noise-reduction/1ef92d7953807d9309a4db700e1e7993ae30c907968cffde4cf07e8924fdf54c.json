  "claims": [
    {
      "claim_id": "noise-tradeoff",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-04c098537dac"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-04c098537dac",
          "exact": "There are many noise reduction algorithms in image processing. In selecting a noise reduction algorithm, one must weigh several factors: the available computer power and time available; whether sacrificing some real detail is acceptable if it allows more noise to be removed; and the characteristics of the noise and the detail in the image, to better make those decisions."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-04c098537dac",
          "subject": "selecting a noise reduction algorithm",
          "predicate": "must weigh several factors",
          "object": "available computer power and time; acceptability of sacrificing real detail for more noise removal; characteristics of the noise and detail",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文区间 [0,373) 逐项支持 claim 的三要素：其一 \"the available computer power and time available\"（约 [139,185)）对应\"可用算力与时间\"；其二 \"whether sacrificing some real detail is acceptable if it allows more noise to be removed\"（约 [186,275)）对应\"是否接受牺牲一些真实细节来换取更多降噪\"；其三 \"the characteristics of the noise and the detail in the image\"（约 [284,341)）对应\"噪声与图像细节的特性\"；引文开头 \"one must weigh several factors\"（约 [105,137)）对应\"权衡多个因素\"。claim 无超出引文的内容，无概念偏移，无遗漏。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-04c098537dac",
          "start": 0,
          "end": 373
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "noise-nlm",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-b1196b6868bf"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-b1196b6868bf",
          "exact": "Another approach for removing noise is based on non-local averaging of all the pixels in an image. In particular, the amount of weighting for a pixel is based on the degree of similarity between a small patch centered on that pixel and the small patch centered on the pixel being de-noised."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-b1196b6868bf",
          "subject": "non-local means",
          "predicate": "removes noise via non-local averaging of all pixels; pixel weight determined by",
          "object": "degree of similarity between the small patch centered on that pixel and the patch centered on the de-noised pixel",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文区间 [0,290) 与 claim 完全对应：第一句 \"non-local averaging of all the pixels in an image\"（约 [45,97)）对应\"基于图像中所有像素的非局部平均去除噪声\"；第二句 \"the amount of weighting for a pixel is based on the degree of similarity between a small patch centered on that pixel and the small patch centered on the pixel being de-noised\"（约 [118,290)）即\"像素的权重由以其为中心的小块与被去噪像素小块之间的相似度决定\"。\"非局部均值\"为 non-local means 的标准译名，仅一处忠实转述，无添加、无遗漏。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-b1196b6868bf",
          "start": 0,
          "end": 290
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "noise-median",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-1f1b599dffe7"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1f1b599dffe7",
          "exact": "A median filter is an example of a nonlinear filter and, if properly designed, is very good at preserving image detail."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1f1b599dffe7",
          "subject": "median filter",
          "predicate": "is a nonlinear filter and, if properly designed, is very good at",
          "object": "preserving image detail",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,119) 与 claim 两句话直接对应：\"A median filter is an example of a nonlinear filter\"（约 [0,55)）对应\"中值滤波是非线性滤波\"；\"if properly designed, is very good at preserving image detail\"（约 [57,119)）对应\"设计得当能很好地保留图像细节\"。\"中值滤波\"即 median filter 的译名；claim 未添加条件变化或程度夸大，逐项支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-1f1b599dffe7",
          "start": 0,
          "end": 119
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "nlm-cost",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-non-local-means",
          "evidence_id": "evidence-5a2113b47195"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-5a2113b47195",
          "exact": "The computational complexity of the non-local means algorithm is quadratic in the number of pixels in the image, making it particularly expensive to apply directly."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-5a2113b47195",
          "subject": "non-local means algorithm",
          "predicate": "has computational complexity quadratic in the number of pixels, making it",
          "object": "particularly expensive to apply directly",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,164) 与 claim 逐项一致：\"The computational complexity of the non-local means algorithm is quadratic in the number of pixels in the image\"（约 [0,112)）对应\"计算复杂度是图像像素数的二次方\"；\"making it particularly expensive to apply directly\"（约 [113,164)）对应\"直接应用非常昂贵\"。claim 中的\"非局部均值算法\"即 non-local means algorithm 的译名；\"二次方\"即 quadratic，无量化偏差；无冗余表述。",
      "rationale_offsets": [
        {
          "source_id": "wiki-non-local-means",
          "evidence_id": "evidence-5a2113b47195",
          "start": 0,
          "end": 164
        }
      ],

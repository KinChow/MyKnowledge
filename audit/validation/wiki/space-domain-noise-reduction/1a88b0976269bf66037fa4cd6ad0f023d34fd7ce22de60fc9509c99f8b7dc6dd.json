  "claims": [
    {
      "claim_id": "noise-tradeoff",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-04c098537dac"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-04c098537dac",
          "exact": "There are many noise reduction algorithms in image processing. In selecting a noise reduction algorithm, one must weigh several factors: the available computer power and time available; whether sacrificing some real detail is acceptable if it allows more noise to be removed; and the characteristics of the noise and the detail in the image, to better make those decisions."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-04c098537dac",
          "subject": "noise reduction algorithm selection",
          "predicate": "requires weighing",
          "object": "available computer power and time; acceptability of sacrificing real detail to remove more noise; characteristics of the noise and the image detail",
          "qualifiers": {
            "origin": "external",
            "evidence_status": "source-reported"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "target 引文（wiki-noise-reduction, evidence-04c098537dac，引文全区间 [0,373]）中 'one must weigh several factors: the available computer power and time available; whether sacrificing some real detail is acceptable if it allows more noise to be removed; and the characteristics of the noise and the detail in the image' 所述三项权衡因素与 claim 的\"可用算力与时间\"\"是否接受牺牲一些真实细节来换取更多降噪\"\"噪声与图像细节的特性\"逐一对应，无增补、无删改、无冲突，故 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-04c098537dac",
          "start": 0,
          "end": 373
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "noise-nlm",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-b1196b6868bf"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-b1196b6868bf",
          "exact": "Another approach for removing noise is based on non-local averaging of all the pixels in an image. In particular, the amount of weighting for a pixel is based on the degree of similarity between a small patch centered on that pixel and the small patch centered on the pixel being de-noised."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-b1196b6868bf",
          "subject": "non-local averaging de-noising approach",
          "predicate": "weights each pixel by",
          "object": "degree of similarity between a small patch centered on that pixel and the small patch centered on the pixel being de-noised",
          "qualifiers": {
            "origin": "external",
            "evidence_status": "source-reported"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "target 引文（wiki-noise-reduction, evidence-b1196b6868bf，引文全区间 [0,290]）中 'non-local averaging of all the pixels in an image'（[0,58] 附近）对应 claim 的\"基于图像中所有像素的非局部平均\"，'the amount of weighting for a pixel is based on the degree of similarity between a small patch centered on that pixel and the small patch centered on the pixel being de-noised'（[129,290]）对应\"像素的权重由以其为中心的小块与被去噪像素小块之间的相似度决定\"，转述忠实，故 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-noise-reduction",
          "evidence_id": "evidence-b1196b6868bf",
          "start": 0,
          "end": 290
        }
      ],
      "advisory": false,

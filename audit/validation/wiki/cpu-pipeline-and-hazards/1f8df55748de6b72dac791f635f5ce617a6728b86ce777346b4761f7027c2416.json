          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-68c51faacee8"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-68c51faacee8",
          "exact": "RAW data hazards occur when one instruction depends on a data value produced by a preceding instruction still in the pipeline. We use architectural dependency arrows to illustrate RAW dependencies in assembly code sequences."

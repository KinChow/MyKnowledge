  "claims": [
    {
      "claim_id": "pipeline-throughput",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "imperial-pipelines",
          "evidence_id": "evidence-8740808fd2b4"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-8740808fd2b4",
          "exact": "**Pipelining doesn't help latency of single instruction it helps throughput of entire workload Pipeline rate limited by slowest pipeline stage Potential speedup = Number pipe stages Unbalanced lengths of pipe stages reduces speedup Time to \"fill\" pipeline and time to \"drain\" it reduces speedup Speedup comes from parallelism - for free – no new hardware Many pipelines are more complex - Pentium 4 \"Netburst\" has 31 stages."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文明确区分单条指令延迟与整个工作负载吞吐，直接支持该 claim。",
      "rationale_offsets": [
        {
          "source_id": "imperial-pipelines",
          "evidence_id": "evidence-8740808fd2b4",
          "start": 0,
          "end": 96
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {

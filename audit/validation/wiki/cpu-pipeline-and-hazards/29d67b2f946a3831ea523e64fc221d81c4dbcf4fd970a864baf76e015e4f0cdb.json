    {
      "claim_id": "name-hazards",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-5c4b286e4308"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-5c4b286e4308",
          "exact": "WAW and WAR Name Hazards: An instruction in the pipeline is writing a register that an earlier instruction in the pipeline is either writing or reading"

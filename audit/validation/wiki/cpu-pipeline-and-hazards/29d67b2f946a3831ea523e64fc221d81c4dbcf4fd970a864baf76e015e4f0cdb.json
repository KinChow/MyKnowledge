      "supporting_quotes": [
        {
          "evidence_id": "evidence-997223e6f9d9",
          "exact": "Hardware Scheduling: Hardware dynamically schedules instructions to avoid RAW hazards, potentially allowing instructions to execute out of order"
        },
        {
          "evidence_id": "evidence-c0c1aa5b322a",
          "exact": "commit stage waits for pending bit of head to be clear"
        },
        {
          "evidence_id": "evidence-77edc60b478e",
          "exact": "new instructions allocated ROB entries at tail"
        },
        {
          "evidence_id": "evidence-c8d9bf0677ec",
          "exact": "Reorder buffer (ROB)\n  - allocated in-order in D stage\n  - updated out-of-order in W stage\n  - deallocated in-order in C stage"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "硬件调度引文说明可允许指令乱序执行；ROB 引文说明其按序分配、乱序更新、按序释放，且提交阶段检查 head，支持通过 ROB 按程序顺序提交。",

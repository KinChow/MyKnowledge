  "claims": [
    {
      "claim_id": "pipeline-throughput",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "imperial-pipelines",
          "evidence_id": "evidence-5f68cf369f34"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-5f68cf369f34",
          "exact": "Pipelining doesn't help latency of single instruction it helps throughput of entire workload"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文明确称流水线“不帮助单条指令延迟”且“帮助整个工作负载吞吐”，与 claim 的吞吐/延迟区分直接一致。",
      "rationale_offsets": [
        {
          "source_id": "imperial-pipelines",
          "evidence_id": "evidence-5f68cf369f34",
          "start": 0,
          "end": 92
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "structural-hazard",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-dafa299071d6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-dafa299071d6",
          "exact": "Structural Hazards: An instruction in the pipeline needs a resource being used by another i"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文将结构冒险描述为流水线中的指令需要另一方正在使用的资源，支持资源竞争核心；但引文在“another i”处截断，未完整明示“另一条指令”。",
      "rationale_offsets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-dafa299071d6",
          "start": 26,
          "end": 117
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "data-hazard",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-f9d0c88149fb"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-f9d0c88149fb",
          "exact": "RAW data hazards occur when one instruction depends on a data value produced by a preceding instruction still in the pipeline."
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文直接定义 RAW：一条指令依赖由仍在流水线中的前序指令产生的数据值，覆盖 claim 的前序产生结果与后序依赖关系。",
      "rationale_offsets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-f9d0c88149fb",
          "start": 0,
          "end": 119
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "control-hazard",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-d4cda8ea4bf4"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d4cda8ea4bf4",
          "exact": "Control Hazards: Whether or not an instruction should be executed depends on a control decision made"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文明确支持控制冒险涉及“某指令是否应执行”依赖控制决策；但在“decision made”处截断，未完整明示该决策由前序指令作出。",
      "rationale_offsets": [
        {
          "source_id": "cornell-processor-microarchitecture",
          "evidence_id": "evidence-d4cda8ea4bf4",
          "start": 26,
          "end": 126
        }
      ],
      "independence": {

      "supporting_quotes": [
        {
          "evidence_id": "evidence-fdc0d2603ccf",
          "exact": "Superscalar processors enable CPI < 1 (i.e., IPC > 1) by executing multiple instructions in parallel"
        },
        {
          "evidence_id": "evidence-c7516137140b",
          "exact": "Can have both in-order and out-of-order superscalar processors, but we will start by exploring in-order"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "第一段将超标量的 IPC 提升归因于并行执行多条指令；第二段明确超标量处理器既可按序也可乱序，支持超标量不等同于乱序执行。",
      "rationale_offsets": [

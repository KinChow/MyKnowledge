  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "subject": "demosaicing",
          "predicate": "is_defined_as",
          "object": "digital image processing algorithm reconstructing full color image from incomplete color samples of CFA overlaid sensor"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文精确定义去马赛克（色彩重建）为从覆有 CFA（如 Bayer 滤色阵）传感器的不完整颜色采样重建完整色彩图像的数字图像处理算法，与 claim 的每个成分（色彩重建、数字图像处理、完整 RGB 重建、CFA/Bayer 示例）完全对应，无冲突且自洽。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 302
        }
      ]
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-523317d6e1c5"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-523317d6e1c5",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-523317d6e1c5",
          "subject": "sensor pixel",
          "predicate": "outputs",
          "object": "raw intensity of one of three filter colors"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文直接支持 claim 前半句：每像素在滤色片后输出三种滤色之一的光强原始值（高度一致）。但 claim 后半句'需算法为每像素估计所有颜色分量色级'在引文中未明示——引文只描述单色强度输出，未说明算法须为全部分量估计色级；该部分需借助 demosaic-definition 的完整重建定义推导，仅凭此引文属部分支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-523317d6e1c5",
          "start": 0,
          "end": 192
        }
      ]
    },
    {
      "claim_id": "demosaic-correlation",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-6aaef04e1cb5"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-6aaef04e1cb5",
          "exact": "Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-6aaef04e1cb5",
          "subject": "spatial and spectral correlation",
          "predicate": "defined_as",
          "object": "spatial: similar colors in homogeneous regions; spectral: dependency between color planes in small regions"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文分别给出空间相关（同质小区域内像素趋向相近颜色值）与谱相关（小区域内不同颜色平面像素值相互依赖）的明确定义，与 claim 两项成分逐字对应，完全支持，自洽无冲突。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-6aaef04e1cb5",
          "start": 0,
          "end": 246
        }
      ]
    },
    {
      "claim_id": "bayer-pattern",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-429e23e81582",
          "exact": "The filter pattern is half green, one quarter red and one quarter blue, hence is also called BGGR, RGBG, GRBG, or RGGB."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-429e23e81582",
          "subject": "bayer filter pattern",
          "predicate": "composed_of",
          "object": "half green, one quarter red, one quarter blue; aliases BGGR/RGBG/GRBG/RGGB"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文直接声明滤色阵排列为半绿、四分之一红、四分之一蓝，并给出 BGGR、RGBG、GRBG、RGGB 四个别名，与 claim 完全一致；用户可见事实在源文本中精确出现，自洽无内部矛盾。",
      "rationale_offsets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582",
          "start": 0,
          "end": 111
        }
      ]
    },
    {
      "claim_id": "bayer-needs-demosaic",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-97e7b6a0a0ad"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-97e7b6a0a0ad",
          "exact": "Since each pixel is filtered to record only one of three colors, the data from each pixel cannot fully specify each of the red, green, and blue values on its own."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-97e7b6a0a0ad",
          "subject": "bayer pixel data",
          "predicate": "cannot_fully_specify",
          "object": "each of red, green and blue values on its own"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文直接支持 claim 前半：每像素仅记录三色之一、故单像素数据无法给出完整 RGB 值。但 claim 后半'需用去马赛克算法由周围同色像素插值得到完整红绿蓝值'未在引文中明示（引文未提及插值或周围像素）；该结论需要同页上下文或 demosaicing 定义推导，属合理外推而非原文断言，故部分支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-97e7b6a0a0ad",
          "start": 0,
          "end": 172
        }
      ]
    },
    {
      "claim_id": "demosaic-artifacts",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-1717e3722229"

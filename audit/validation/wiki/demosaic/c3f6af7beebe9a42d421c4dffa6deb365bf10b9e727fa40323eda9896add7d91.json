        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文明确称最常见伪影为摩尔纹（Moiré），并列举其表现为重复图案、颜色伪影或不真实的迷宫状排列，与 claim 完全对应；引文语境为图像伪影主题，与去马赛克伪影主题一致，未发现与同组其他引文的冲突。",
      "rationale_offsets": [

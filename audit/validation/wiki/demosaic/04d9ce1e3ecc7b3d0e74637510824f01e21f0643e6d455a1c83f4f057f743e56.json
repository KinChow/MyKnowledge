  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "subject": "Demosaicing",
          "predicate": "is_defined_as",
          "object": "digital image processing algorithm reconstructing a full color image from incomplete color samples from a sensor with a CFA such as a Bayer filter"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文与 claim 逐字一致：引文将 Demosaicing 界定为从覆有 CFA（如 Bayer 滤色阵）的传感器不完整颜色采样重建全彩图像的数字图像处理算法，并给出别名 color reconstruction，与 claim 的措辞（含“去马赛克/色彩重建”双名）完全吻合；target 与 claim 声明一致，属直接支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 258
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors. Thus, an algorithm is needed to estimate for each pixel the color levels for all color components, rather than a single component."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "subject": "sensor pixel",
          "predicate": "outputs_raw_intensity_of",
          "object": "one of three filter colors, requiring estimation of all color components per pixel"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文逐字对应 claim 的全部要素：像素位于滤色片后、输出三色之一的光强，故需算法为每像素估计所有颜色分量而非单分量；与 claim 的“只输出三种滤色之一的光强”及“估计所有颜色分量的色级，而非单一分量”完全一致，属直接支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05",
          "start": 0,
          "end": 316
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-correlation",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "exact": "More sophisticated demosaicing algorithms exploit the spatial and/or spectral correlation of pixels within a color image. Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "subject": "sophisticated demosaicing algorithms",
          "predicate": "exploit",
          "object": "spatial correlation (similar colors within a small homogeneous region) and spectral correlation (dependency between color planes in a small region)"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文完整给出两种相关性的定义并与之匹配：空间相关为同质小区域内像素取相近颜色值，谱相关为小区域内不同颜色平面像素值的相互依赖；claim 对两者的表述与引文一致（“颜色平面”对应“different color planes”），属直接支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11",
          "start": 0,
          "end": 373
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "bayer-pattern",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-429e23e81582",
          "exact": "The filter pattern is half green, one quarter red and one quarter blue, hence is also called BGGR, RGBG, GRBG, or RGGB."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-429e23e81582",
          "subject": "Bayer filter pattern",
          "predicate": "comprises",
          "object": "half green, one quarter red, one quarter blue; also called BGGR, RGBG, GRBG, RGGB"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文逐字表述 Bayer 滤镜图案为半绿、四分之一红、四分之一蓝，并列出别称 BGGR、RGBG、GRBG、RGGB，与 claim 完全一致；target 来源（wiki-bayer-filter）与 claim 主题（Bayer 滤色阵）相符，属直接支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582",
          "start": 0,
          "end": 112
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "bayer-needs-demosaic",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-d3cba69be38a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d3cba69be38a",
          "exact": "Since each pixel is filtered to record only one of three colors, the data from each pixel cannot fully specify each of the red, green, and blue values on its own. To obtain a full-color image, various demosaicing algorithms can be used to interpolate a set of complete red, green, and blue values for each pixel. These algorithms make use of the surrounding pixels of the corresponding colors to estimate the values for a particular pixel."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d3cba69be38a",
          "subject": "Bayer sensor data",
          "predicate": "requires",
          "object": "demosaicing algorithms interpolating complete RGB values using surrounding same-color pixels"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "引文覆盖 claim 全部环节：每像素仅记录三色之一、单像素数据本身无法完整指定 RGB、需去马赛克算法插值得到完整红绿蓝值、并利用周围对应颜色像素进行估计；与 claim 表述一一对应，属直接支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-d3cba69be38a",
          "start": 0,
          "end": 395
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {

  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "subject": "demosaicing (color reconstruction)",
          "predicate": "is defined as",
          "object": "a digital image processing algorithm that reconstructs a full color image from the incomplete color samples output by a sensor overlaid with a CFA such as a Bayer filter",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "目标引文（wiki-demosaicing/evidence-1b4036ae3965，按引文文本计算字符区间 [0,255)）逐字支持 claim 的全部命题：demosaicing 亦称 color reconstruction，是数字图像处理算法，用于从覆盖 CFA（如 Bayer 滤镜）的传感器输出的不完整颜色采样重建全彩图像。claim 为引文的忠实中文转述，无任何超出引文的断言。单一 target，无多源独立性判定需求。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 255
        }
      ]
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-523317d6e1c5"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-523317d6e1c5",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-523317d6e1c5",
          "subject": "each sensor output pixel value",
          "predicate": "indicates",
          "object": "a raw intensity of exactly one of the three filter colors",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "目标引文（wiki-demosaicing/evidence-523317d6e1c5，[0,163)）仅支持 claim 的前提命题：每个像素在滤色片后输出三种滤色之一的光强。claim 的结论命题'因此需要算法为每个像素估计所有颜色分量的色级，而非单一分量'在引文中并未出现——引文未提及任何算法、估计或全色重建的必要性，该结论属于由前提外推的推断而非引文所述内容，故判定 partially_supported。单一 target，无多源独立性判定需求。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-523317d6e1c5",
          "start": 0,
          "end": 163
        }
      ]
    },
    {
      "claim_id": "demosaic-correlation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-6aaef04e1cb5"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-6aaef04e1cb5",
          "exact": "Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-6aaef04e1cb5",
          "subject": "spatial correlation and spectral correlation",
          "predicate": "are defined as",
          "object": "the tendency of pixels toward similar color values within a small homogeneous region, and the dependency between pixel values of different color planes in a small image region",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001"
      ],
      "rationale": "目标引文（wiki-demosaicing/evidence-6aaef04e1cb5，[0,238)）逐字支持 claim 中空间相关与谱相关的两条定义，与 claim 完全一致。但 claim 首句'高级去马赛克算法利用像素的空间相关与谱相关'这一归因断言在引文中没有对应表述——引文仅给出两条相关性的定义，未述及任何算法利用该相关性，该归因属超出引文的框架性延伸，判定 partially_supported。单一 target，无多源独立性判定需求。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-6aaef04e1cb5",
          "start": 0,
          "end": 238
        }
      ]
    },
    {
      "claim_id": "bayer-pattern",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",

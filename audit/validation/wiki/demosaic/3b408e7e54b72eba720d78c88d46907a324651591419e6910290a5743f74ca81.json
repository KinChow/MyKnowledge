  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "subject": "demosaicing",
          "predicate": "defined_as",
          "object": "digital image processing algorithm reconstructing a full color image from the incomplete color samples output from a CFA-overlaid sensor",
          "qualifiers": {
            "aka": "color reconstruction",
            "cfa_example": "Bayer filter"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,254) 给出 demosaicing 的完整定义：一种从覆有色彩滤色阵列（CFA，例举 Bayer filter）的图像传感器所输出的不完整颜色采样（incomplete color samples）重建全彩图像（full color image）的数字图像处理算法，并明示又称 color reconstruction。claim 的定义、别称、输入、输出与算法类别与引文逐项对应，无超出、无弱化。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 254
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors. Thus, an algorithm is needed to estimate for each pixel the color levels for all color components, rather than a single component."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "subject": "sensor pixel",
          "predicate": "represents",
          "object": "raw intensity of one of the three filter colors",
          "qualifiers": {
            "requirement": "an algorithm must estimate for each pixel the color levels for all color components, not a single component"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,294) 说明传感器每个像素在滤色片后输出三种滤色之一的原始光强（raw intensity of one of the three filter colors），并因此需要算法为每个像素估计所有颜色分量的色级而非单一分量（estimate for each pixel the color levels for all color components, rather than a single component）。与 claim 的两层表述（滤色片后单色输出；需估计全部颜色分量）完全一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05",
          "start": 0,
          "end": 294
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-correlation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "exact": "More sophisticated demosaicing algorithms exploit the spatial and/or spectral correlation of pixels within a color image. Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "subject": "sophisticated demosaicing algorithms",
          "predicate": "exploit",
          "object": "spatial and/or spectral correlation of pixels",
          "qualifiers": {
            "spatial_correlation": "tendency of pixels to assume similar color values within a small homogeneous region",
            "spectral_correlation": "dependency between pixel values of different color planes in a small image region",
            "scope": "and/or"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,360) 中，空间相关与谱相关的定义（pixels to assume similar color values within a small homogeneous region；dependency between the pixel values of different color planes in a small image region）与 claim 后半段一致；但引文原文为 exploit the spatial and/or spectral correlation，即算法可只利用其一（and/or 为析取），而 claim 表述为\"利用像素的空间相关与谱相关\"（与 = 严格合取），弱化并超出引文的 or 限定，故仅部分支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11",
          "start": 0,
          "end": 360
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "bayer-pattern",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-429e23e81582",
          "exact": "The filter pattern is half green, one quarter red and one quarter blue, hence is also called BGGR, RGBG, GRBG, or RGGB."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-429e23e81582",
          "subject": "Bayer filter pattern",
          "predicate": "composed_of",
          "object": "half green, one quarter red, one quarter blue",
          "qualifiers": {
            "also_called": [
              "BGGR",
              "RGBG",
              "GRBG",
              "RGGB"
            ]
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,119) 明确：滤色阵排列为半绿、四分之一红、四分之一蓝，因此也称 BGGR、RGBG、GRBG 或 RGGB，与 claim 的\"半绿、四分之一红、四分之一蓝，故也称 BGGR、RGBG、GRBG 或 RGGB\"逐项一致（含 hence 因果连接词的对应翻译）。",
      "rationale_offsets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582",
          "start": 0,
          "end": 119
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "bayer-needs-demosaic",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-d3cba69be38a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d3cba69be38a",
          "exact": "Since each pixel is filtered to record only one of three colors, the data from each pixel cannot fully specify each of the red, green, and blue values on its own. To obtain a full-color image, various demosaicing algorithms can be used to interpolate a set of complete red, green, and blue values for each pixel. These algorithms make use of the surrounding pixels of the corresponding colors to estimate the values for a particular pixel."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d3cba69be38a",
          "subject": "Bayer pixel data",
          "predicate": "cannot_fully_specify",
          "object": "complete red, green, and blue values per pixel",
          "qualifiers": {
            "method": "demosaicing algorithms interpolate using surrounding pixels of the corresponding colors"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,439) 三段分别支持：每个像素只被滤光为记录三色之一；单像素数据自身无法完整给出红绿蓝值；需用去马赛克算法为每像素插值出完整红绿蓝（interpolate a set of complete red, green, and blue values for each pixel），且利用周围同色像素（make use of the surrounding pixels of the corresponding colors）。与 claim 全部要素吻合。",
      "rationale_offsets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-d3cba69be38a",
          "start": 0,
          "end": 439
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-artifacts",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-1717e3722229"

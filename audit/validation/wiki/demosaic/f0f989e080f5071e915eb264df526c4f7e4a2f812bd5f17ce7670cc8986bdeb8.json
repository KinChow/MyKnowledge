  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "subject": "Demosaicing",
          "predicate": "is also known as and reconstructs",
          "object": "color reconstruction; a digital image processing algorithm reconstructing full color images from incomplete CFA sensor samples",
          "qualifiers": {
            "CFA_example": "Bayer filter"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "目标引文在区间 0-254 明确给出去马赛克又称 color reconstruction，并说明其为 digital image processing algorithm，用于从覆有 CFA 如 Bayer filter 的传感器不完整颜色采样重建 full color image，覆盖 claim 全部要点。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 254
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors. Thus, an algorithm is needed to estimate for each pixel the color levels for all color components, rather than a single component."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "subject": "each sensor pixel",
          "predicate": "outputs and requires estimation",
          "object": "raw intensity of one of three filter colors; algorithm estimates all color components per pixel",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "目标引文区间 0-294 说明每个像素位于彩色滤镜后，仅表示三种滤色之一的 raw intensity，并且需要算法为每个像素估计 all color components，而非 single component，直接支持 claim。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05",
          "start": 0,
          "end": 294
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-correlation",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "exact": "More sophisticated demosaicing algorithms exploit the spatial and/or spectral correlation of pixels within a color image. Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "subject": "more sophisticated demosaicing algorithms",
          "predicate": "exploit",
          "object": "spatial and/or spectral correlation of pixels",
          "qualifiers": {
            "spatial_correlation": "similar color values within a small homogeneous region",
            "spectral_correlation": "dependency between pixel values of different color planes in a small image region"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "目标引文区间 0-360 逐项定义：高级算法利用 spatial and/or spectral correlation；空间相关是在小同质区域取相近颜色值；谱相关是小区域内不同颜色平面像素值的依赖关系，支持 claim。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11",
          "start": 0,
          "end": 360
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {

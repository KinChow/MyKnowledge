          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-429e23e81582",
          "exact": "The filter pattern is half green, one quarter red and one quarter blue, hence is also called BGGR, RGBG, GRBG, or RGGB."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-429e23e81582",
          "subject": "Bayer filter pattern",
          "predicate": "is",
          "object": "half green, one quarter red, one quarter blue; also called BGGR, RGBG, GRBG, or RGGB"
        }
      ],
      "applied_rule_refs": [
        "EVD-001"
      ],
      "rationale": "引文 [0,119] 完整对应 claim 全部要素：半绿（half green）、四分之一红（one quarter red）、四分之一蓝（one quarter blue），且 hence is also called BGGR, RGBG, GRBG, or RGGB（故称四种简称）。claim 为引文忠实转述，无额外断言，故 supported。",

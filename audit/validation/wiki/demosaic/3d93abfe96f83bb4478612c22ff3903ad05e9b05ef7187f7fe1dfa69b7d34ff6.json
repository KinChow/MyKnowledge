  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "subject": "demosaicing",
          "predicate": "is-defined-as",
          "object": "a digital image processing algorithm that reconstructs a full color image from incomplete color samples output by an image sensor overlaid with a CFA (e.g. Bayer)"
        }
      ],
      "applied_rule_refs": [
        "EVD-001"
      ],
      "rationale": "引文 [0,253] 逐要素对应 claim：Demosaicing 又称 color reconstruction（色彩重建）、数字图像处理算法、从覆有滤色阵列（如 Bayer 滤色阵）的传感器输出的不完整颜色采样重建全彩图像。claim 为引文的忠实转述（中文翻译），无引文之外的附加断言，故 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 253
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-523317d6e1c5"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-523317d6e1c5",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-523317d6e1c5",
          "subject": "sensor pixel",
          "predicate": "outputs",
          "object": "a raw intensity of one of the three filter colors (each pixel is behind a color filter)"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,55]（each pixel ... behind a color filter）与 [97,163]（each indicating a raw intensity of one of the three filter colors）支持 claim 前半句“每个像素在滤色片后只输出三种滤色之一的光强”；但 claim 后半句“因此需要算法为每个像素估计所有颜色分量的色级，而非单一分量”为引文未包含的推断——引文仅描述传感器输出，未提及任何算法或对全色分量的估计行为，故 partially_supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-523317d6e1c5",
          "start": 0,
          "end": 55

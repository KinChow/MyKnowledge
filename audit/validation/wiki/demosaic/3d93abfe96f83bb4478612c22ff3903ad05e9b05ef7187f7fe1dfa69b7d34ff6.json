    {
      "claim_id": "demosaic-correlation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-6aaef04e1cb5"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-6aaef04e1cb5",
          "exact": "Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-6aaef04e1cb5",
          "subject": "spatial and spectral correlation",
          "predicate": "defined-as",
          "object": "pixels assuming similar color values within a small homogeneous region / dependency between pixel values of different color planes in a small region"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,123] 对应空间相关定义（pixels ... similar color values within a small homogeneous region），[124,238] 对应谱相关定义（dependency between the pixel values of different color planes in a small image region），与 claim 的两条定义完全一致；但 claim 首句“高级去马赛克算法利用像素的空间相关与谱相关”在引文中并未出现——引文只定义两概念，未声明算法利用行为，故 partially_supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-6aaef04e1cb5",
          "start": 0,
          "end": 123
        },
        {

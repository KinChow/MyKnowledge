  "claims": [
    {
      "claim_id": "demosaic-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1b4036ae3965",
          "exact": "Demosaicing, also known as color reconstruction, is a digital image processing algorithm used to reconstruct a full color image from the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文（evidence-1b4036ae3965，wiki-demosaicing）逐项对应 claim 的四个要素：定义名称（also known as color reconstruction）、算法类别（a digital image processing algorithm）、输入（the incomplete color samples output from an image sensor overlaid with a color filter array (CFA) such as a Bayer filter）与目标（reconstruct a full color image），无信息增量或丢失，claim 与引文一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-1b4036ae3965",
          "start": 0,
          "end": 280
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "demosaic-definition",
        "basis": [
          {
            "source_id": "wiki-demosaicing",
            "evidence_id": "evidence-1b4036ae3965"
          }
        ]
      }
    },
    {
      "claim_id": "demosaic-single-pixel",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-97ea187b1d05",
          "exact": "Since each pixel of the sensor is behind a color filter, the output is an array of pixel values, each indicating a raw intensity of one of the three filter colors. Thus, an algorithm is needed to estimate for each pixel the color levels for all color components, rather than a single component."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文（evidence-97ea187b1d05，wiki-demosaicing）明确表述：每像素只输出三种滤色之一的光强（each indicating a raw intensity of one of the three filter colors），因此需算法估计每像素所有颜色分量的色级（to estimate for each pixel the color levels for all color components, rather than a single component），与 claim 的因果结构完全一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-97ea187b1d05",
          "start": 0,
          "end": 315
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "demosaic-single-pixel",
        "basis": [
          {
            "source_id": "wiki-demosaicing",
            "evidence_id": "evidence-97ea187b1d05"
          }
        ]
      }
    },
    {
      "claim_id": "demosaic-correlation",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-453b0e3eba11",
          "exact": "More sophisticated demosaicing algorithms exploit the spatial and/or spectral correlation of pixels within a color image. Spatial correlation is the tendency of pixels to assume similar color values within a small homogeneous region of an image. Spectral correlation is the dependency between the pixel values of different color planes in a small image region."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文（evidence-453b0e3eba11，wiki-demosaicing）逐条给出 claim 的两类相关：空间相关（pixels to assume similar color values within a small homogeneous region）与谱相关（dependency between the pixel values of different color planes in a small image region），并说明高级算法利用 spatial and/or spectral correlation，与 claim 一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-demosaicing",
          "evidence_id": "evidence-453b0e3eba11",
          "start": 0,
          "end": 344
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "demosaic-correlation",
        "basis": [
          {
            "source_id": "wiki-demosaicing",
            "evidence_id": "evidence-453b0e3eba11"
          }
        ]
      }
    },
    {
      "claim_id": "bayer-pattern",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-bayer-filter",
          "evidence_id": "evidence-429e23e81582"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-429e23e81582",
          "exact": "The filter pattern is half green, one quarter red and one quarter blue, hence is also called BGGR, RGBG, GRBG, or RGGB."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文（evidence-429e23e81582，wiki-bayer-filter）完整覆盖 claim 两个要点：排列比例（half green, one quarter red and one quarter blue）与别名（also called BGGR, RGBG, GRBG, or RGGB），无遗漏或附加限定，claim 与引文一致。",
      "rationale_offsets": [

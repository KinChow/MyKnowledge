      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-9da6093a732a",
          "exact": "Most personal computer power supply units meet the ATX standard and convert from alternating current (AC) at between 120 and 277 volts provided from a power outlet to direct current (DC) at a much lower voltage: typically 12, 5, or 3.3 volts."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-9da6093a732a",
          "subject": "most personal computer power supply units",
          "predicate": "meet the ATX standard and convert",
          "object": "AC 120-277V from a power outlet to DC at a much lower voltage (typically 12, 5, or 3.3 volts)",
          "qualifiers": {
            "origin": "external",
            "confidentiality": "public",
            "evidence_status": "source-reported"
          }
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,242) 完整覆盖 claim 全部要素：'Most personal computer power supply units meet the ATX standard' 对应 '大多数个人电脑电源单元符合 ATX 标准'；'alternating current (AC) at between 120 and 277 volts provided from a power outlet' 对应 '电源插座提供的 120–277V 交流电'；'direct current (DC) at a much lower voltage: typically 12, 5, or 3.3 volts' 对应 '更低电压（典型 12V、5V 或 3.3V）的直流电'。数值（120–277、12/5/3.3）与语义映射精确，无冲突，判 supported。",

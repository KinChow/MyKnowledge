    {
      "claim_id": "hardware-cpu",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "web-computer-science-computer-hardware",
          "evidence_id": "evidence-84a42a7dca80"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-84a42a7dca80",
          "exact": "At least one CPU (central processing unit), which performs the majority of computational tasks required for a computer to operate. Often described informally as the brain of the computer, the CPU fetches program instructions from random-access memory (RAM), decodes and executes them, then returns results for further processing by other components. This process is known as the instruction cycle."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-84a42a7dca80",
          "subject": "CPU",
          "predicate": "executes the instruction cycle (fetch from RAM, decode, execute, return results for further processing) and performs the majority of computational tasks",
          "object": "computer operation",
          "qualifiers": {
            "origin": "external",
            "confidentiality": "public",
            "evidence_status": "source-reported"
          }
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文区间 [0,395) 三段与 claim 逐段对应：'performs the majority of computational tasks required for a computer to operate' 对应 '执行计算机所需的大部分计算任务'；'the CPU fetches program instructions from random-access memory (RAM), decodes and executes them, then returns results for further processing by other components' 对应 '从 RAM 取指令、译码并执行，然后返回结果供其他部件进一步处理'；'This process is known as the instruction cycle' 对应 '（即指令周期）'。语义完整一致，无矛盾或缺漏，判 supported。",
      "rationale_offsets": [
        {
          "source_id": "web-computer-science-computer-hardware",
          "evidence_id": "evidence-84a42a7dca80",
          "start": 0,
          "end": 395

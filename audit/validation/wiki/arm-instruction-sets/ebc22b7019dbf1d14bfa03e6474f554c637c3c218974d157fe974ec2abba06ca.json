  "claims": [
    {
      "claim_id": "arm-isa-family",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "web-computer-science-arm-instruction-sets",
          "evidence_id": "evidence-c6331b5d1245"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-c6331b5d1245",
          "exact": "ARM (stylised in lowercase as arm) is a family of RISC instruction set architectures for computer processors. Arm Holdings develops the instruction set architecture and licenses them to other companies, who build the physical devices that use the instruction set."
        }
      ],
      "applied_rule_refs": [
        "VAL-001"
      ],
      "rationale": "引文原文 [0, 38] 明确表述 \"ARM (stylised in lowercase as arm)\"，对应 claim 的 ARM 小写 stylised 为 arm；[63, 118] \"a family of RISC instruction set architectures\" 直接支持 \"RISC 指令集架构家族\"；[120, 224] \"Arm Holdings develops the instruction set architecture and licenses them to other companies, who build the physical devices\" 直接支持 \"Arm Holdings 设计指令集并授权给其他公司构建物理设备\"。claim 各元素与引文逐句对应，无超出引文的附加断言，判定为 supported。独立性：target 的 provenance 为空对象且引文无转载声明，无法举证独立性，basis 置空。",
      "rationale_offsets": [
        {
          "source_id": "web-computer-science-arm-instruction-sets",
          "evidence_id": "evidence-c6331b5d1245",
          "start": 0,
          "end": 232
        }
      ],
      "independence": {

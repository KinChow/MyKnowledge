      "supporting_quotes": [
        {
          "evidence_id": "evidence-c6331b5d1245",
          "exact": "ARM (stylised in lowercase as arm) is a family of RISC instruction set architectures for computer processors. Arm Holdings develops the instruction set architecture and licenses them to other companies, who build the physical devices that use the instruction set."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-c6331b5d1245",
          "subject": "ARM (stylised in lowercase as arm)",
          "predicate": "is",
          "object": "a family of RISC instruction set architectures; Arm Holdings develops the ISA and licenses it to other companies who build the physical devices"
        }
      ],
      "applied_rule_refs": [

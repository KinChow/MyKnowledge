      "supporting_quotes": [
        {
          "evidence_id": "evidence-47e5f178256f",
          "exact": "We consider here a famous and very useful law in queueing theory called Little's Law, also known as l = λw, which asserts that the time average number of customers in a queueing system, l, is equal to the rate at which customers arrive, λ, × the average sojourn time of a customer, w."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-47e5f178256f",
          "subject": "Little's Law",
          "predicate": "states",
          "object": "l = λw",
          "qualifiers": {
            "meaning": "time average number of customers equals arrival rate times average sojourn time"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002",
        "ARC-002"
      ],
      "rationale": "引文明确写出“l = λw”，并说明队列系统中的时间平均顾客数等于到达率乘以平均逗留时间。provenance 为空，未提供 publisher、derived_from、independence_group 或转载声明，因此独立性为 independence_unknown。",

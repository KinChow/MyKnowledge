  "claims": [
    {
      "claim_id": "little-law",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "little-law-columbia",
          "evidence_id": "evidence-47e5f178256f"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-47e5f178256f",
          "exact": "We consider here a famous and very useful law in queueing theory called Little's Law, also known as l = λw, which asserts that the time average number of customers in a queueing system, l, is equal to the rate at which customers arrive, λ, × the average sojourn time of a customer, w."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-47e5f178256f",
          "subject": "Little's Law",
          "predicate": "asserts",
          "object": "l = λw; time average number of customers equals arrival rate times average sojourn time"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "target区间[0,284)明确称Little's Law又称l = λw，并说明队列系统中的顾客时间平均数l等于到达率λ乘以平均逗留时间w，因此claim成立。单一target未形成多引文冲突；provenance为空，独立性无法举证。",
      "rationale_offsets": [
        {
          "source_id": "little-law-columbia",
          "evidence_id": "evidence-47e5f178256f",
          "start": 0,
          "end": 284
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },

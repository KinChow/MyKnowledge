      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-5138110b0629",
          "exact": "Sampling consists of taking regular snapshots of the application's call stack to create a statistical profile. This is a good option for low overhead profiling."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-5138110b0629",
          "subject": "sampling",
          "predicate": "consists of",
          "object": "regular snapshots of the application's call stack creating a statistical profile"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 evidence-5138110b0629 表明 sampling consists of taking regular snapshots of the application's call stack to create a statistical profile（区间 [21,109)），与 claim 的快照形式周期性对调用栈取快照形成统计概况逐词对应：regular/周期性、snapshots of call stack/对调用栈取快照、statistical profile/统计概况，直接支持。",
      "rationale_offsets": [

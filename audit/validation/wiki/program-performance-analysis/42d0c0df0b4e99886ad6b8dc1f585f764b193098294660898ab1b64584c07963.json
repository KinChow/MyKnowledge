      "supporting_quotes": [
        {
          "evidence_id": "evidence-8406af58cade",
          "exact": "Steps to Use Queuing Theory\n1. Define the System: Identify the key components of the system, such as the arrival process, service process, queue discipline, and number of servers.\n2. Collect Data: Gather data on customer arrival rates, service times, and queue lengths to understand the system's behavior."
        }
      ],

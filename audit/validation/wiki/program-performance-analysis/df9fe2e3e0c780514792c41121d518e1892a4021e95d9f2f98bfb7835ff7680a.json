            "step2": "collect data"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文列出排队分析步骤：先定义系统（到达过程、服务过程、队列规则、服务台数），再收集到达率、服务时间、队列长度数据，与 claim 完全对应。",

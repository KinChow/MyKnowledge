          "predicate": "captures",
          "object": "specific program events such as entering or exiting a function"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文说明 tracing 每次发生时捕获特定程序事件（如函数进入/退出），与 claim 的“逐个记录每个事件”一致。",
      "rationale_offsets": [

  "claims": [
    {
      "claim_id": "little-law",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "little-law-columbia",
          "evidence_id": "evidence-47e5f178256f"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-47e5f178256f",
          "exact": "We consider here a famous and very useful law in queueing theory called Little's Law, also known as l = λw, which asserts that the time average number of customers in a queueing system, l, is equal to the rate at which customers arrive, λ, × the average sojourn time of a customer, w."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-47e5f178256f",
          "subject": "Little's Law",
          "predicate": "states",
          "object": "l = λw",
          "qualifiers": {
            "time_average_number": "l",
            "arrival_rate": "λ",
            "average_sojourn_time": "w"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文直接给出 Little's Law 的等式 l = λw，并说明 l 是顾客时间平均数量、λ 是到达率、w 是平均逗留时间，与 claim 完全一致。",
      "rationale_offsets": [
        {
          "source_id": "little-law-columbia",
          "evidence_id": "evidence-47e5f178256f",
          "start": 1806,
          "end": 2090
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {

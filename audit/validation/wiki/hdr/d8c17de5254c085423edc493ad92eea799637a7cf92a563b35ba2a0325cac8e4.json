    },
    {
      "claim_id": "hdr-capture",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-hdri",
          "evidence_id": "evidence-f41c52103f5f"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-f41c52103f5f",
          "exact": "In photography and videography, a technique, commonly named high dynamic range (HDR) allows the dynamic range of photos and videos to be captured beyond the native capability of the camera. It consists of capturing multiple frames of the same scene but with different exposures and then combining them into one, resulting in an image with a dynamic range higher than the individually captured frames."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-f41c52103f5f",
          "subject": "HDR technique in photography and videography",
          "predicate": "captures",
          "object": "multiple frames of the same scene with different exposures, combines them into one, yielding dynamic range beyond native capability of the camera and higher than individually captured frames",
          "qualifiers": {
            "domain": "photography and videography"
          }
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文完整支撑 claim 三个要素：（1）'In photography and videography' 对应 claim 限定的'摄影中的'；（2）'capturing multiple frames of the same scene but with different exposures and then combining them into one' 对应'拍摄同一场景多帧不同曝光再合并'；（3）'captured beyond the native capability of the camera' 与'dynamic range higher than the individually captured frames' 对应'得到高于单帧的、超出相机原生能力的动态范围'。claim 为引文的忠实中文转述，无超出或矛盾内容。",
      "rationale_offsets": [

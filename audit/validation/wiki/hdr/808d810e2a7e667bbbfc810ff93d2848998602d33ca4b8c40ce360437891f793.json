        "basis": []
      }
    },
    {
      "claim_id": "hdr-capture",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-hdri",
          "evidence_id": "evidence-f41c52103f5f"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-f41c52103f5f",
          "exact": "In photography and videography, a technique, commonly named high dynamic range (HDR) allows the dynamic range of photos and videos to be captured beyond the native capability of the camera. It consists of capturing multiple frames of the same scene but with different exposures and then combining them into one, resulting in an image with a dynamic range higher than the individually captured frames."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-f41c52103f5f",
          "subject": "the HDR technique",
          "predicate": "allows",
          "object": "capturing dynamic range beyond native camera capability by combining multiple frames of the same scene taken with different exposures, yielding a range higher than individually captured frames"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,400) 区间完整表述该 claim 的全部要素：第一句说明该技术使照片/视频的动态范围可超出相机原生能力（beyond the native capability of the camera）；第二句说明其实现方式是拍摄同一场景多帧不同曝光（multiple frames of the same scene but with different exposures）再合并（combining them into one），得到高于单帧的动态范围（a dynamic range higher than the individually captured frames）。claim 中“摄影中的 HDR 技术”“多帧不同曝光再合并”“高于单帧”“超出相机原生能力”均逐项对应引文；引文还涵盖 videography，claim 收窄为 photography 属子集表述，不构成矛盾或夸大，判定为 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-hdri",
          "evidence_id": "evidence-f41c52103f5f",
          "start": 0,
          "end": 400
        }
      ],

  "claims": [
    {
      "claim_id": "hdr-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-hdri",
          "evidence_id": "evidence-15fd931b7867"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-15fd931b7867",
          "exact": "In this context, the term high dynamic range means there is a large amount of variation in light levels within a scene or an image. The dynamic range refers to the range of luminosity between the brightest area and the darkest area of that scene or image."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-15fd931b7867",
          "subject": "high dynamic range",
          "predicate": "means",
          "object": "large amount of variation in light levels within a scene or an image"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,255) 区间由两句组成：第一句明确定义 high dynamic range 为场景或图像内光线水平存在大量变化（a large amount of variation in light levels within a scene or an image），对应 claim 前分句；第二句定义 dynamic range 为该场景或图像最亮区与最暗区之间的亮度范围（range of luminosity between the brightest area and the darkest area），对应 claim 后分句。claim 两个分句与引文逐句一一对应，无增删改，判定为 fully supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-hdri",
          "evidence_id": "evidence-15fd931b7867",
          "start": 0,
          "end": 255
        }
      ],
      "independence": {

      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-15fd931b7867",
          "exact": "In this context, the term high dynamic range means there is a large amount of variation in light levels within a scene or an image. The dynamic range refers to the range of luminosity between the brightest area and the darkest area of that scene or image."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-15fd931b7867",
          "subject": "high dynamic range / dynamic range",
          "predicate": "defined as",
          "object": "large amount of variation in light levels within a scene or an image; range of luminosity between the brightest area and the darkest area of that scene or image"
        }
      ],
      "applied_rule_refs": [
        "VAL-001"
      ],
      "rationale": "引文前半句（[26,131)）定义 high dynamic range 为场景或图像内光线水平的大量变化，与 claim 前半句一一对应；后半句（[132,255)）定义 dynamic range 为最亮区与最暗区之间的亮度范围（luminosity），与 claim 后半句对应。claim 为引文的忠实转述，未引入引文之外的信息，判定为 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-hdri",
          "evidence_id": "evidence-15fd931b7867",
          "start": 26,
          "end": 131
        },

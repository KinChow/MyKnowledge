      "supporting_quotes": [
        {
          "evidence_id": "evidence-d81b6af46b9f",
          "exact": "In mathematics, a matrix (pl.: matrices) is a rectangular array of numbers or other mathematical objects with elements or entries arranged in rows and columns, usually satisfying certain properties of addition and multiplication."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d81b6af46b9f",
          "subject": "matrix",
          "predicate": "is",
          "object": "rectangular array of numbers or other mathematical objects with elements or entries arranged in rows and columns, usually satisfying certain properties of addition and multiplication"
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,229) 完整定义矩阵：数学中的矩形数组、由数或其他数学对象构成、元素按行列排列、通常满足加法与乘法性质；claim 是对该句的逐项忠实翻译，无添加、遗漏或弱化，判定 supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-matrix-math",

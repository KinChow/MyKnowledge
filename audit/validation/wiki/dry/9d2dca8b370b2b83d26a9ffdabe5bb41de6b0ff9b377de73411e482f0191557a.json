      "supporting_quotes": [
        {
          "evidence_id": "evidence-3e823b953bf6",
          "exact": "\"Don't repeat yourself\" (DRY) is a principle of software development aimed at reducing repetition of information which is likely to change, replacing it with abstractions that are less likely to change, or using data normalization which avoids redundancy in the first place."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-3e823b953bf6",
          "subject": "DRY (Don't Repeat Yourself)",
          "predicate": "is described as",
          "object": "a software development principle aimed at reducing repetition of information which is likely to change, replacing it with abstractions that are less likely to change, or using data normalization which avoids redundancy in the first place",
          "qualifiers": {
            "support": "direct",
            "evidence_status": "source-reported",
            "origin": "external",
            "confidentiality": "public"
          }
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文 evidence-3e823b953bf6（[0,274)）完整直接陈述了 claim 的四个构成部分：DRY 是软件开发原则（is a principle of software development）；旨在减少可能变化的信息的重复（reducing repetition of information which is likely to change）；用更不易变化的抽象替代（abstractions that are less likely to change）；或用数据规范化从源头避免冗余（data normalization which avoids redundancy in the first place）。claim 为引文的忠实转述（英文缩写展开首字母大写属常规排版差异，不影响语义），未超出引文断言，按 EVD-001 直接支持规则判定为 supported。",
      "rationale_offsets": [

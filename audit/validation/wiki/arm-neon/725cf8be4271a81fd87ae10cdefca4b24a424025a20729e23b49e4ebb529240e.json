      "supporting_quotes": [
        {
          "evidence_id": "evidence-068c54a90cb8",
          "exact": "Neon is the implementation of Arm’s Advanced SIMD architecture."
        },
        {
          "evidence_id": "evidence-068c54a90cb8",
          "exact": "Thirty-two 128-bit vector registers, each capable of containing multiple lanes of data."
        },
        {
          "evidence_id": "evidence-068c54a90cb8",
          "exact": "SIMD instructions to operate simultaneously on those multiple lanes of data"
        }
      ],

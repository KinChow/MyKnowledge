      "supporting_quotes": [
        {
          "evidence_id": "evidence-2339f6e0de43",
          "exact": "- RISC uses a small set of simple, fixed-length instructions and follows a load/store approach, enabling efficient and fast execution."
        },
        {
          "evidence_id": "evidence-a1d5f1e8c5ff",
          "exact": "- CISC uses a larger set of complex, variable-length instructions that can perform multiple operations, often requiring multiple clock cycles."
        }
      ],
      "applied_rule_refs": [

  "claims": [
    {
      "claim_id": "isa-definition",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "ddca-lecture8-isa-ii",
          "evidence_id": "evidence-1a37cd32c397"
        },
        {
          "source_id": "ddca-lecture8-isa-ii",
          "evidence_id": "evidence-fa9a29315420"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-1a37cd32c397",
          "exact": "◼ The ISA is the interface between what the software commands and what the hardware carries out ◼ The ISA specifies ❑ The memory organization ◼ Address space (LC-3: 2<sup>16</sup>, MIPS: 2<sup>32</sup>) ◼ Addressability (LC-3: 16 bits, MIPS: 8 bits) ◼ Word- or Byte-addressable ❑ The register set ◼ 8 registers (R0 to R7) in LC-3 ◼ 32 registers in MIPS ❑ The instruction set ◼ Opcodes ◼ Data types ◼ Addressing modes ◼ Length and format of instructions Microarchitecture ISA Program Algorithm Problem Circuits Electrons"
        },
        {
          "evidence_id": "evidence-fa9a29315420",
          "exact": "◼ **Traditional (ISA-only) definition:** \"The term architecture is used here to describe the attributes of a system as seen by the programmer, i.e., the conceptual structure and functional behavior **as distinct from** the organization of the dataflow and controls, the logic design, and the physical implementation."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "ARC-002"
      ],
      "rationale": "第一条引文明确将 ISA 定义为软件命令与硬件执行之间的接口，并列出程序可见的内存组织、寄存器集和指令集属性；第二条引文说明架构的概念结构和功能行为区别于数据流与控制组织、逻辑设计及物理实现，因此共同支持该定义。",
      "rationale_offsets": [
        {
          "source_id": "ddca-lecture8-isa-ii",
          "evidence_id": "evidence-1a37cd32c397",
          "start": 0,
          "end": 60
        },
        {
          "source_id": "ddca-lecture8-isa-ii",
          "evidence_id": "evidence-fa9a29315420",
          "start": 0,
          "end": 60
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "isa-vs-micro",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "ddca-lecture9a-isa-microarchitecture",
          "evidence_id": "evidence-99b25955f40a"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-99b25955f40a",
          "exact": "❑ Programmer sees a dataflow execution order ◼ Microarchitecture: How the **underlying implementation actually executes** instructions ❑ Microarchitecture can execute instructions in any order as long as it obeys the semantics specified by the ISA when making the instruction results visible to software ◼Programmer should see the order specified by the ISA"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文明确说明微架构是底层实现实际执行指令的方式，并允许在遵守 ISA 语义且按 ISA 规定向软件呈现结果的前提下以任意顺序执行，直接支持该 claim。",
      "rationale_offsets": [
        {
          "source_id": "ddca-lecture9a-isa-microarchitecture",
          "evidence_id": "evidence-99b25955f40a",
          "start": 0,
          "end": 60
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "same-isa-implementations",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "ddca-lecture9a-isa-microarchitecture",
          "evidence_id": "evidence-962563aa0e01"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-962563aa0e01",
          "exact": "◼ A specific **implementation** of the ISA ◼ How do we implement the ISA? ❑ We will discuss this for many lectures ◼ There can be many implementations of the same ISA ❑ **MIPS** R2000, R3000, R4000, R6000, R8000, R10000, … ❑ **x86**: Intel 80486, Pentium, Pentium Pro, Pentium 4, Kaby Lake, Coffee Lake, Comet Lake, Ice Lake, Golden Cove, Sapphire Rapids, …, AMD K5, K7, K9, Bulldozer, BobCat, Ryzen X, … ❑ **POWER** 4, 5, 6, 7, 8, 9, 10 (IBM), …, **PowerPC** 604, 605, 620, … ❑ **ARM** Cortex-M\\*, ARM Cortex-A\\*, NVIDIA Denver, Apple A\\*, M1, … ❑ **Alpha** 21064, 21164, 21264, 21364, … ❑ **RISC-V** … ❑ **z/Architecture** … ❑ … 69"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文直接陈述同一 ISA 可以有许多实现，并列举 MIPS、x86、POWER、ARM 等多个实现实例，支持该 claim。",
      "rationale_offsets": [
        {
          "source_id": "ddca-lecture9a-isa-microarchitecture",
          "evidence_id": "evidence-962563aa0e01",
          "start": 0,
          "end": 60
        }
      ],

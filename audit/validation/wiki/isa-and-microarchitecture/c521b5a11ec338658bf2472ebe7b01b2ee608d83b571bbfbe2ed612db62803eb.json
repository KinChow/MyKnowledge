      "supporting_quotes": [
        {
          "evidence_id": "evidence-1a37cd32c397",
          "exact": "◼ The ISA is the interface between what the software commands and what the hardware carries out"
        },
        {
          "evidence_id": "evidence-fa9a29315420",
          "exact": "The term architecture is used here to describe the attributes of a system as seen by the programmer, i.e., the conceptual structure and functional behavior **as distinct from** the organization of the dataflow and controls, the logic design, and the physical implementation."
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文一明确将 ISA 定义为软件命令与硬件执行之间的接口；引文二将程序员可见的概念结构和功能行为与数据流/控制组织、逻辑设计和物理实现相区别。",
      "rationale_offsets": [
        {
          "source_id": "ddca-lecture8-isa-ii",
          "evidence_id": "evidence-1a37cd32c397",
          "start": 0,
          "end": 95

      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-99b25955f40a",
          "exact": "Microarchitecture: How the **underlying implementation actually executes** instructions"
        },
        {
          "evidence_id": "evidence-99b25955f40a",
          "exact": "Microarchitecture can execute instructions in any order as long as it obeys the semantics specified by the ISA when making the instruction results visible to software"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文将微架构表述为底层实现实际执行指令的方式，并明确允许任意顺序执行，条件是软件可见结果遵守 ISA 语义；同一引文还说明程序员应看到 ISA 指定的顺序。重复 target 未提供独立的第二份证据。",

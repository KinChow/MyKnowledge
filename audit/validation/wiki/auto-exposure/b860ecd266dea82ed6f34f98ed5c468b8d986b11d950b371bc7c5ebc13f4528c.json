  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "exposure",
          "predicate": "is combination of",
          "object": "length of time and illuminance at the photosensitive material",
          "qualifiers": {
            "time_controlled_by": "shutter speed",
            "illuminance_depends_on": [
              "lens aperture",
              "scene luminance"
            ]
          }
        }
      ],
      "applied_rule_refs": [
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[0,99)直述曝光是时间长度与感光材料处照度的组合；[100,157)说明快门速度控制曝光时间；[162,231)说明照度取决于镜头光圈与场景亮度。claim 前三句与引文逐字对应；末句\"更慢快门/更大光圈/更亮场景→更大曝光\"为前述因果链的直接推论（曝光随曝光时间与照度组合而增），属可接受推理。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 0,
          "end": 99
        },

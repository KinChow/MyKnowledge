    {
      "claim_id": "exposure-equation",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d5683985cdc6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d5683985cdc6",
          "exact": "The relationship of recommended photographic exposure to a scene's average luminance is given by the camera exposure equation A^2/T = B*Sx/K, where A is the relative aperture (f-number), T is the exposure time (shutter speed) in seconds, B is the scene luminance, Sx is the ASA arithmetic film speed, and K is the reflected-light meter calibration constant."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d5683985cdc6",
          "subject": "recommended photographic exposure",
          "predicate": "is related to scene average luminance by",
          "object": "A^2/T = B*Sx/K (A: relative aperture, T: exposure time, B: scene luminance, Sx: ASA film speed, K: meter calibration constant)"
        }
      ],
      "applied_rule_refs": [
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[0,84)说明曝光方程把推荐曝光与场景平均亮度关联；[97,141)给出精确公式 A^2/T = B*Sx/K；[148,174)/[186,224)/[237,262)/[263,299)/[304,356)分别对应 A（相对孔径/光圈）、T（曝光时间/快门）、B（场景亮度）、Sx（ASA 算术胶片速度，即感光度）、K（反射光测光校准常数），与 claim 释义一致。\"APEX\"命名未逐字出现于引文，但引文来源即 APEX 系统条目（source_id: wiki-apex-system），且该等式即 APEX 曝光方程，归属一致，不构成矛盾。",

  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "exposure",
          "predicate": "is combination of",
          "object": "time length and illuminance at photosensitive material",
          "qualifiers": {
            "time_controlled_by": "shutter speed",
            "illuminance_depends_on": "lens aperture and scene luminance"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文完整定义曝光为曝光时间与照度的组合（[0,99)），并明确曝光时间由快门速度控制、照度取决于镜头光圈与场景亮度（[100,231)）；claim 中\"更慢的快门、更大的光圈、更亮的场景产生更大曝光\"是上述时间与照度单调定义的直接推论，与引文一致，未超出证据内容。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 0,
          "end": 99
        },
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 100,
          "end": 231
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-iso",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "exact": "Faster film, that is, film with a higher ISO rating, requires less exposure to make a readable image."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "subject": "film with higher ISO rating",
          "predicate": "requires less exposure to",
          "object": "make a readable image",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文直接陈述\"更高 ISO 评级的胶片需要更少曝光即可得到可读图像\"（[0,101)），claim 仅将 film 译为\"胶片/感光材料\"并在括注中将 ISO rating 意译为\"感光度\"，语义与引文逐点一致，无添加或失真内容。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365",
          "start": 0,
          "end": 101
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-underexposure",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "exact": "A photograph may be described as underexposed when it has a loss of shadow detail, that is, when important dark areas are \"muddy\" or indistinguishable from black, known as \"blocked-up shadows\"."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "subject": "underexposed photograph",
          "predicate": "has",
          "object": "loss of shadow detail",
          "qualifiers": {
            "dark_areas": "muddy or indistinguishable from black",
            "term": "blocked-up shadows"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文逐字定义欠曝为暗部细节丢失、重要暗区\"浑浊\"或与黑色无法区分，并给出术语 blocked-up shadows（[0,192)）；claim 的\"死黑/压死暗部\"即对该术语的意译，整体与引文一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0",
          "start": 0,
          "end": 192
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-equation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-258de73af385",
          "exact": "The relationship of recommended photographic exposure to a scene's average luminance is given by the camera exposure equation"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-258de73af385",
          "subject": "recommended photographic exposure and scene average luminance",
          "predicate": "is related by",
          "object": "the camera exposure equation",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文仅说明\"推荐曝光与场景平均亮度的关系由相机曝光方程给出\"（[0,125)），属概念引导句；claim 中的具体公式 A²/T = B·Sx/K 及符号含义（A 光圈、T 快门、B 场景亮度、Sx 感光度、K 校准常数）在引文中完全未出现，无法由该证据验证，故仅\"曝光方程关联两者\"这一概念部分受支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385",
          "start": 0,
          "end": 125
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-ev",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d3ce18f48bf3"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "exact": "Taking base-2 logarithms of both sides of the exposure equation and separating numerators and denominators reduces exposure calculation to a matter of addition"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "subject": "exposure calculation",
          "predicate": "reduces to",
          "object": "a matter of addition",
          "qualifiers": {
            "via": "base-2 logarithms of both sides and separating numerators and denominators"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文支持\"对曝光方程取以 2 为底对数并分离分子分母后，曝光计算化为加法\"（[0,158)）；但 claim 中的具体恒等式 Ev = Av + Tv = Bv + Sv 及其符号定义未见于引文，属引文之外的内容，故仅\"取对数化为加法\"部分受支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d3ce18f48bf3",
          "start": 0,
          "end": 158
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }

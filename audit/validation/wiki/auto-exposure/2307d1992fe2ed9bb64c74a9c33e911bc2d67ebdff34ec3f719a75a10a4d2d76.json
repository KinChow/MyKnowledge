          "start": 163,
          "end": 194
        }
      ]
    },
    {
      "claim_id": "exposure-equation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-258de73af385",
          "exact": "The relationship of recommended photographic exposure to a scene's average luminance is given by the camera exposure equation"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-258de73af385",
          "subject": "recommended photographic exposure",
          "predicate": "is-related-to",
          "object": "scene average luminance by the camera exposure equation"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文[0,125)仅陈述“推荐曝光与场景平均亮度的关系由曝光方程给出”，支持claim中的关系陈述；但claim核心的方程形式A²/T = B·Sx/K、各符号含义（A/T/B/Sx/K）及“APEX（Additive System of Photographic Exposure）”名称均未出现在引文中，属未引证内容，故为partially_supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385",
          "start": 0,
          "end": 125
        }
      ]
    },
    {
      "claim_id": "exposure-ev",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d3ce18f48bf3"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "exact": "Taking base-2 logarithms of both sides of the exposure equation and separating numerators and denominators reduces exposure calculation to a matter of addition"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "subject": "exposure calculation",
          "predicate": "reduces-to",
          "object": "a matter of addition (via base-2 logarithms and numerator/denominator separation)"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文[0,159)支持“对曝光方程两边取以2为底对数并分离分子分母，曝光计算化为加法”；但claim中的符号等式“Ev = Av + Tv = Bv + Sv”未出现在引文中（引文仅以“a matter of addition”概括），该具体等式为未引证内容，故为partially_supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d3ce18f48bf3",
          "start": 0,
          "end": 159
        }
      ]
    },
    {
      "claim_id": "metering-modes",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-metering-mode",
          "evidence_id": "evidence-04409216fcbc"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-04409216fcbc",
          "exact": "In photography, the metering mode refers to the way in which a camera determines exposure."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-04409216fcbc",
          "subject": "metering mode",
          "predicate": "refers-to",
          "object": "the way in which a camera determines exposure"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文[0,81)支持“测光模式指相机确定曝光的方式”；但claim中“一般可选点测光、中央重点平均测光或多区测光”的枚举在引文中完全缺失（引文仅一句定义，未列出任何具体测光模式），该部分为未引证内容，故为partially_supported。",
      "rationale_offsets": [

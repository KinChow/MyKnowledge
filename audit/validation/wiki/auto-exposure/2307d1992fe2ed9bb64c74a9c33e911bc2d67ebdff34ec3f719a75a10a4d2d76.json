  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "exposure",
          "predicate": "is-a-combination-of",
          "object": "exposure time (controlled by shutter speed) and illuminance (depends on lens aperture and scene luminance)"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文[0,99)直接陈述“曝光是时间与感光材料上照度的组合”，[100,231)陈述“曝光时间由相机快门速度控制、照度取决于镜头光圈与场景亮度”，逐字支持claim前两部分；但“更慢的快门、更大的光圈、更亮的场景产生更大曝光”在引文中并无“产生更大曝光”的显式表述，属单调性推论，故为partially_supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 0,
          "end": 99
        },
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 100,
          "end": 231
        }
      ]
    },
    {
      "claim_id": "exposure-iso",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "exact": "Faster film, that is, film with a higher ISO rating, requires less exposure to make a readable image."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "subject": "film with a higher ISO rating",
          "predicate": "requires",
          "object": "less exposure to make a readable image"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文[0,100)（“Faster film, that is, film with a higher ISO rating, requires less exposure to make a readable image”）与claim核心断言逐字对应；claim中“(感光度)”为ISO的gloss、“胶片/感光材料”为对film的轻微泛化，不改变断言本身，故判定supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365",
          "start": 0,
          "end": 100
        }
      ]
    },
    {
      "claim_id": "exposure-underexposure",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "exact": "A photograph may be described as underexposed when it has a loss of shadow detail, that is, when important dark areas are \"muddy\" or indistinguishable from black, known as \"blocked-up shadows\"."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "subject": "underexposed photograph",
          "predicate": "has",
          "object": "loss of shadow detail (muddy or indistinguishable from black, \"blocked-up shadows\")"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文[0,82)支持“失去暗部细节即可描述为欠曝”，[97,162)支持“重要暗区‘muddy’或与黑色不可区分”，[163,194)支持“known as ‘blocked-up shadows’”（即死黑/压死暗部）；claim各成分与引文逐点对应，故判定supported。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0",
          "start": 0,
          "end": 82
        },

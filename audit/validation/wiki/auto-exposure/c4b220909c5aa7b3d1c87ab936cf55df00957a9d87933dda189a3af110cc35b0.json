  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "exposure",
          "predicate": "is_combination_of",
          "object": "length of time (shutter speed) and illuminance (aperture, scene luminance)",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,231] 直接陈述曝光是时间长度与感光材料照度的组合，且曝光时间由快门速度控制、照度取决于光圈与场景亮度；claim 中更慢快门/更大光圈/更亮场景产生更大曝光是举出组合关系方向性的简洁归纳，引文完整支持 claim 的每一条要素，无超出证据的断言。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 0,
          "end": 231
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-iso",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "exact": "Faster film, that is, film with a higher ISO rating, requires less exposure to make a readable image."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "subject": "film with higher ISO rating",
          "predicate": "requires",
          "object": "less exposure to make a readable image",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,101] 与 claim 完全对应：更高 ISO 的胶片（即快速胶片）需要更少曝光即可得到可读图像；claim 中感光材料为 film 的泛称，未改变引文语义。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365",
          "start": 0,
          "end": 101
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-underexposure",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "exact": "A photograph may be described as underexposed when it has a loss of shadow detail, that is, when important dark areas are \"muddy\" or indistinguishable from black, known as \"blocked-up shadows\"."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "subject": "underexposed photograph",
          "predicate": "characterized_by",
          "object": "loss of shadow detail: important dark areas muddy or indistinguishable from black (blocked-up shadows)",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,193] 明确给出欠曝定义：当暗部细节丢失、重要暗区浑浊或与黑色无法区分（即 blocked-up shadows，对应死黑/压死暗部）时称欠曝，与 claim 逐项一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0",
          "start": 0,
          "end": 193
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-equation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-258de73af385",
          "exact": "The relationship of recommended photographic exposure to a scene's average luminance is given by the camera exposure equation"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-258de73af385",
          "subject": "recommended photographic exposure and scene average luminance",
          "predicate": "related_by",
          "object": "camera exposure equation",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,125] 仅声称推荐曝光与场景平均亮度的关系由相机曝光方程给定，但引文中未出现方程形式 A²/T = B·Sx/K，也未定义 A、T、B、Sx、K 各变量的含义；claim 的方程与符号定义部分无直接引文支持，仅前半句（方程关联二者）被支持。",

    {
      "claim_id": "exposure-ev",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d3ce18f48bf3"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "exact": "Taking base-2 logarithms of both sides of the exposure equation and separating numerators and denominators reduces exposure calculation to a matter of addition"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "subject": "exposure calculation",
          "predicate": "reduced_to",
          "object": "addition via base-2 logarithms and separation of numerators/denominators",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "EVD-001",
        "VAL-001"
      ],
      "rationale": "引文 [0,158] 支持对曝光方程取以 2 为底对数并分离分子分母后曝光计算化为加法；但引文未给出具体等式 Ev = Av + Tv = Bv + Sv（未出现 Ev/Av/Tv/Bv/Sv 符号），claim 的符号化表达式部分无引文支持，故为部分支持。",

  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "Exposure",
          "predicate": "is determined by",
          "object": "length of time and illuminance; exposure time by shutter speed; illuminance by aperture and scene luminance"
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[0,91)说明曝光由时间长度和感光材料照度组合而成；[93,151)说明曝光时间由快门速度控制；[161,221)说明照度取决于镜头光圈和场景亮度，支持 claim 的因素关系。",
      "rationale_offsets": [

      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文[44,69)给出欠曝与暗部细节丢失的关系；[84,183)说明重要暗区浑浊或与黑色不可区分，并称为 blocked-up shadows，支持 claim。",
      "rationale_offsets": [

  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "exposure",
          "predicate": "is_a_combination_of",
          "object": "exposure time and illuminance at the photosensitive material",
          "qualifiers": {
            "exposure_time_controlled_by": "shutter speed",
            "illuminance_depends_on": "lens aperture and scene luminance"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文 [0,231] 定义曝光为'曝光时间与感光材料上照度的组合'（a combination of the length of time and the illuminance at the photosensitive material），并说明曝光时间由快门速度控制（'Exposure time is controlled in a camera by shutter speed'），照度取决于镜头光圈与场景亮度（'the illuminance depends on the lens aperture and the scene luminance'）。claim 三层陈述（时间与照度共同决定、快门/光圈/亮度分别作用、更慢快门/更大光圈/更亮场景产生更大曝光）与引文逐点对应；末句是'曝光=时间与照度之组合'这一定义在正方向上的直接蕴含，未引入引文之外的独立事实，属忠实转述。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 0,
          "end": 231
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-iso",
      "verdict": "supported",
      "targets": [

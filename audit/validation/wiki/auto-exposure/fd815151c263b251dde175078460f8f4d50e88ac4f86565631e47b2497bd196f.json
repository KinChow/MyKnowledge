    {
      "claim_id": "exposure-equation",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d5683985cdc6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-d5683985cdc6",
          "exact": "The relationship of recommended photographic exposure to a scene's average luminance is given by the camera exposure equation A^2/T = B*Sx/K, where A is the relative aperture (f-number), T is the exposure time (shutter speed) in seconds, B is the scene luminance, Sx is the ASA arithmetic film speed, and K is the reflected-light meter calibration constant."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-d5683985cdc6",
          "subject": "camera exposure equation",
          "predicate": "equals",
          "object": "A^2/T = B*Sx/K",
          "qualifiers": {
            "A": "relative aperture (f-number)",
            "T": "exposure time (shutter speed) in seconds",
            "B": "scene luminance",
            "Sx": "ASA arithmetic film speed",
            "K": "reflected-light meter calibration constant"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文 [0,357] 给出曝光方程 A^2/T = B*Sx/K 并定义全部变量：A 为相对孔径（f-number）、T 为曝光时间（秒）、B 为场景亮度、Sx 为 ASA 算术感光度、K 为反射光测光校准常数，与 claim 的变量说明（A 光圈、T 快门、B 场景亮度、Sx 感光度、K 校准常数）逐项一致；首句'the relationship of recommended photographic exposure to a scene's average luminance'对应 claim 的'把推荐曝光与场景平均亮度相关联'。该引文出自 APEX 条目（source_id: wiki-apex-system），故 claim 将其归入 APEX 体系亦与来源一致。",
      "rationale_offsets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d5683985cdc6",
          "start": 0,
          "end": 357
        }
      ],
      "advisory": false,
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-ev",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-94fb33e0def3"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-94fb33e0def3",
          "exact": "Taking base-2 logarithms of both sides of the exposure equation and separating numerators and denominators reduces exposure calculation to a matter of addition: Ev = Av + Tv = Bv + Sv, where Av is the aperture value, Tv is the time value, Sv is the speed value (aka sensitivity value), and Bv is the luminance value (aka brightness value)."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-94fb33e0def3",
          "subject": "exposure calculation",
          "predicate": "reduces_to",
          "object": "addition: Ev = Av + Tv = Bv + Sv",
          "qualifiers": {
            "Av": "aperture value",
            "Tv": "time value",
            "Sv": "speed value (sensitivity value)",
            "Bv": "luminance value (brightness value)"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文 [0,339] 完整陈述'对曝光方程两边取以 2 为底的对数并将分子分母分离，可把曝光计算化为加法：Ev = Av + Tv = Bv + Sv'，且对 Av（aperture value 光圈值）、Tv（time value 时间值）、Sv（speed/sensitivity value 感光值）、Bv（luminance/brightness value 亮度值）的定义与 claim 完全一致；引文 'reduces exposure calculation to a matter of addition' 对应 claim 的'曝光计算化为加法'，无歧义或遗漏。",
      "rationale_offsets": [
        {

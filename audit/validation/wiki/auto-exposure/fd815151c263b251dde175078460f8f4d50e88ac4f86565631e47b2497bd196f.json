    {
      "claim_id": "exposure-underexposure",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "exact": "A photograph may be described as underexposed when it has a loss of shadow detail, that is, when important dark areas are \"muddy\" or indistinguishable from black, known as \"blocked-up shadows\"."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "subject": "underexposed photograph",
          "predicate": "has",
          "object": "loss of shadow detail",
          "qualifiers": {
            "symptom": "important dark areas muddy or indistinguishable from black",
            "term": "blocked-up shadows"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "EVD-001",
        "VAL-001",
        "VAL-002"
      ],
      "rationale": "引文 [0,193] 对 underexposed 的定义与 claim 逐项一致：'loss of shadow detail'（暗部细节丢失）即重要暗区'muddy'（浑浊）或'indistinguishable from black'（与黑色不可区分），且引文明确该现象术语为'blocked-up shadows'；claim 中'死黑/压死暗部'为该英文术语的中文对应译法，其余部分为忠实转述，无新增或冲突内容。",
      "rationale_offsets": [

      ],
      "observations": [
        {
          "evidence_id": "evidence-d3ce18f48bf3",
          "subject": "the exposure equation",
          "predicate": "reduced_by_base2_logarithms_to",
          "object": "a matter of addition",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [

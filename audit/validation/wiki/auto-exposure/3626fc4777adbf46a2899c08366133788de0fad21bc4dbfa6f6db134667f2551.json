  "claims": [
    {
      "claim_id": "exposure-factors",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "exact": "Exposure is a combination of the length of time and the illuminance at the photosensitive material. Exposure time is controlled in a camera by shutter speed, and the illuminance depends on the lens aperture and the scene luminance."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-43626ae79bd6",
          "subject": "exposure",
          "predicate": "is_combination_of",
          "object": "the length of time and the illuminance at the photosensitive material",
          "qualifiers": {
            "time_control": "shutter speed",
            "illuminance_factors": "lens aperture and scene luminance"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文案文完整支持 claim 前两分句：第一句（[0,99)）定义曝光为时间与照度之组合，第二句（[100,231)）指出快门速度控制曝光时间、照度取决于镜头光圈与场景亮度。但 claim 第三分句（\"更慢的快门、更大的光圈、更亮的场景产生更大曝光\"）的单调方向性为推论：引文仅言明 \"combination\" 与 \"depends on\"，未明示各因素与曝光量的单调增减关系，故部分支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 0,
          "end": 99
        },
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-43626ae79bd6",
          "start": 100,
          "end": 231
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-iso",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "exact": "Faster film, that is, film with a higher ISO rating, requires less exposure to make a readable image."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-445f3cce2365",
          "subject": "film with a higher ISO rating",
          "predicate": "requires_less_exposure_to_make",
          "object": "a readable image",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文（[0,101)）与 claim 逐项对应：\"higher ISO rating\" 对应\"更高 ISO（感光度）\"，\"requires less exposure to make a readable image\" 对应\"需要更少的曝光即可得到可读图像\"。claim 中\"胶片/感光材料\"即引文所指 film（胶片即感光材料），无超出引文的内容。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-445f3cce2365",
          "start": 0,
          "end": 101
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-underexposure",
      "verdict": "supported",
      "targets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "exact": "A photograph may be described as underexposed when it has a loss of shadow detail, that is, when important dark areas are \"muddy\" or indistinguishable from black, known as \"blocked-up shadows\"."
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-733c5ff57fe0",
          "subject": "underexposed photograph",
          "predicate": "has",
          "object": "loss of shadow detail / blocked-up shadows",
          "qualifiers": {
            "condition": "important dark areas are muddy or indistinguishable from black"
          }
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文（[0,189)）与 claim 逐项对应：\"a loss of shadow detail\" 对应\"暗部细节丢失\"，\"muddy or indistinguishable from black\" 对应\"浑浊或与黑色无法区分\"，\"blocked-up shadows\" 对应\"死黑/压死暗部\"。引文完整支持该 claim。",
      "rationale_offsets": [
        {
          "source_id": "wiki-exposure-photography",
          "evidence_id": "evidence-733c5ff57fe0",
          "start": 0,
          "end": 189
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-equation",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385"
        }
      ],
      "supporting_quotes": [
        {
          "evidence_id": "evidence-258de73af385",
          "exact": "The relationship of recommended photographic exposure to a scene’s average luminance is given by the camera exposure equation"
        }
      ],
      "observations": [
        {
          "evidence_id": "evidence-258de73af385",
          "subject": "recommended photographic exposure",
          "predicate": "is_related_to",
          "object": "a scene’s average luminance via the camera exposure equation",
          "qualifiers": {}
        }
      ],
      "applied_rule_refs": [
        "WIKI-001",
        "VAL-001"
      ],
      "rationale": "引文（[0,126)）仅说明\"推荐曝光与场景平均亮度的关系由相机曝光方程给出\"，与 claim 的主句（APEX 用曝光方程关联推荐曝光与场景平均亮度）对应；但 claim 给出的具体方程 A²/T = B·Sx/K 及各符号定义（A 光圈、T 快门、B 场景亮度、Sx 感光度、K 校准常数）在引文中完全未出现，无法由该引文验证公式本身，故部分支持。",
      "rationale_offsets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-258de73af385",
          "start": 0,
          "end": 126
        }
      ],
      "independence": {
        "group_id": "independence_unknown",
        "basis": []
      }
    },
    {
      "claim_id": "exposure-ev",
      "verdict": "partially_supported",
      "targets": [
        {
          "source_id": "wiki-apex-system",
          "evidence_id": "evidence-d3ce18f48bf3"

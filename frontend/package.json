{
  "name": "myknowledge-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "prepare-content": "node scripts/prepare-content.mjs",
    "build:release": "node scripts/build-release.mjs",
    "build": "npm run build:release",
    "validate:projection": "node scripts/validate-projection.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate-build": "node scripts/validate-build.mjs",
    "leak-gate": "node scripts/leak-gate.mjs",
    "test:browser": "npm run test:browser:public && npm run test:browser:local",
    "test:browser:public": "playwright test",
    "test:browser:local": "MYK_E2E_SUITE=local playwright test",
    "test:browser:chrome": "MYK_E2E_CHANNEL=chrome npm run test:browser",
    "check:browser": "npm run build && npm run test:browser"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.4",
    "astro": "7.1.3",
    "cytoscape": "3.34.2",
    "mermaid": "^12.0.0",
    "pagefind": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}

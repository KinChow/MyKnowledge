---
// 构建时从 public/generated/catalog.json 生成静态导航页——数据只来自
// projection catalog（与文章页同一真源），不含任何运行时获取。
// 分类三个维度：domain（域分组）× kind（类型）× tags（标签面，客户端过滤）。
import fs from 'node:fs';
import path from 'node:path';

const catalogPath = path.join(process.cwd(), 'public/generated/catalog.json');
const catalog = fs.existsSync(catalogPath)
  ? JSON.parse(fs.readFileSync(catalogPath, 'utf8'))
  : { items: [] };
const graphPath = path.join(process.cwd(), 'public/generated/graph.json');
const graph = fs.existsSync(graphPath)
  ? JSON.parse(fs.readFileSync(graphPath, 'utf8'))
  : { nodes: [], edges: [] };

const items = Array.isArray(catalog.items) ? catalog.items : [];

const DOMAIN_LABELS = {
  'computer-science': { label: '计算机科学', color: '#2563eb' },
  'multimedia': { label: '多媒体与影像', color: '#0d9488' },
  'work-methods': { label: '工作方法', color: '#d97706' },
  'tools': { label: '工具', color: '#7c3aed' },
  'reading-notes': { label: '读书笔记', color: '#db2777' },
};
const KIND_LABELS = { knowledge: '知识', reference: '参考' };
const domainOf = (item) => item.domain || 'other';

const groups = new Map();
for (const item of items) {
  const d = domainOf(item);
  if (!groups.has(d)) groups.set(d, []);
  groups.get(d).push(item);
}
const orderedGroups = [...groups.entries()]
  .sort((a, b) => b[1].length - a[1].length)
  .map(([domain, list]) => [
    domain,
    list.sort((a, b) => String(a.title || a.id).localeCompare(String(b.title || b.id), 'zh-Hans')),
  ]);

// 标签面：出现 ≥5 次的标签按热度取前 36 个
const tagCount = new Map();
for (const item of items) for (const t of item.tags || []) tagCount.set(t, (tagCount.get(t) || 0) + 1);
const topTags = [...tagCount.entries()]
  .filter(([, c]) => c >= 5)
  .sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))
  .slice(0, 36);

const degree = new Map();
for (const e of graph.edges || []) {
  degree.set(e.source, (degree.get(e.source) || 0) + 1);
  degree.set(e.target, (degree.get(e.target) || 0) + 1);
}
const relEdges = (graph.edges || []).filter((e) => e.kind === 'rel').length;
const tagEdges = (graph.edges || []).filter((e) => e.kind === 'tag').length;
const total = items.length;

// 内联数据供客户端标签过滤（只含 id/tags，足够小）
const filterData = JSON.stringify(
  items.map((i) => ({ id: i.id, tags: i.tags || [] }))
).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MyKnowledge · 知识库</title>
    <style>
      :root { --ink:#1e293b; --muted:#64748b; --line:#e2e8f0; --bg:#f8fafc; --card:#fff; --accent:#2563eb; }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--ink); font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; }
      .wrap { max-width:1080px; margin:0 auto; padding:48px 24px 80px; }
      header h1 { font-size:32px; margin:0 0 8px; letter-spacing:-0.5px; }
      header p { color:var(--muted); margin:0 0 24px; font-size:15px; line-height:1.7; }
      .stats { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:28px; }
      .stat { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:10px 18px; }
      .stat b { font-size:20px; display:block; }
      .stat span { color:var(--muted); font-size:12px; }
      .stat a { color:var(--accent); text-decoration:none; font-size:12px; }
      .tagbar { display:flex; flex-wrap:wrap; gap:8px; padding:16px; background:var(--card);
        border:1px solid var(--line); border-radius:10px; margin-bottom:36px; }
      .tagbar .tag { font-size:12.5px; padding:3px 10px; border-radius:999px; border:1px solid var(--line);
        color:var(--ink); cursor:pointer; background:var(--card); user-select:none; }
      .tagbar .tag small { color:var(--muted); }
      .tagbar .tag.active { background:var(--accent); border-color:var(--accent); color:#fff; }
      .tagbar .tag.active small { color:#dbeafe; }
      .tagbar .clear { font-size:12.5px; color:var(--accent); background:none; border:none; cursor:pointer;
        text-decoration:underline; display:none; padding:3px 4px; }
      section { margin-bottom:40px; }
      section.hidden { display:none; }
      h2 { font-size:18px; margin:0 0 14px; display:flex; align-items:center; gap:8px; }
      h2 .dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
      h2 .count { color:var(--muted); font-weight:400; font-size:14px; }
      .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:10px; }
      a.card { display:block; background:var(--card); border:1px solid var(--line); border-radius:8px;
        padding:10px 14px; text-decoration:none; color:var(--ink); transition:border-color .15s, transform .15s; }
      a.card:hover { border-color:var(--accent); transform:translateY(-1px); }
      a.card.hide { display:none; }
      a.card .title { font-size:13.5px; line-height:1.45; }
      a.card .meta { display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; }
      a.card .meta i { font-style:normal; font-size:10.5px; color:var(--muted);
        border:1px solid var(--line); border-radius:4px; padding:1px 5px; }
      a.card .rel { color:var(--muted); font-size:11px; margin-top:4px; }
      .empty { display:none; color:var(--muted); padding:32px 0; text-align:center; font-size:14px; }
      footer { color:var(--muted); font-size:12px; margin-top:56px; border-top:1px solid var(--line);
        padding-top:16px; line-height:1.8; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <h1>MyKnowledge</h1>
        <p>证据驱动的个人知识库公共投影。每篇文章的结论都有可溯源的证据锚定，经确定性校验与 LLM 证据审计后发布。</p>
      </header>
      <div class="stats">
        <div class="stat"><b>{total}</b><span>篇已发布</span></div>
        <div class="stat"><b>{orderedGroups.length}</b><span>个领域</span></div>
        <div class="stat"><b>{topTags.length}</b><span>个高频标签</span></div>
        <div class="stat"><b>{relEdges}+{tagEdges}</b><span>显式/标签关联</span></div>
        <div class="stat"><a href="/graph/">→ 知识图谱</a></div>
      </div>
      <div class="tagbar" id="tagbar">
        {topTags.map(([tag, count]) => (
          <button class="tag" data-tag={tag}>{tag} <small>{count}</small></button>
        ))}
        <button class="clear" id="tag-clear">清除筛选</button>
      </div>
      {orderedGroups.map(([domain, list]) => (
        <section data-domain={domain}>
          <h2>
            <span class="dot" style={`background:${(DOMAIN_LABELS[domain] || {}).color || '#94a3b8'}`}></span>
            {(DOMAIN_LABELS[domain] || {}).label || domain}
            <span class="count">{list.length} 篇</span>
          </h2>
          <div class="grid">
            {list.map((item) => (
              <a class="card" href={`${item.route || `/wiki/${item.id}/`}`} data-tags={(item.tags || []).join(' ')}>
                <div class="title">{item.title || item.id}</div>
                <div class="meta">
                  {(KIND_LABELS[item.kind] || item.kind) && <i>{KIND_LABELS[item.kind] || item.kind}</i>}
                  {(item.tags || []).slice(0, 3).map((t) => <i>{t}</i>)}
                </div>
                {(degree.get(item.id) || 0) > 0 && <div class="rel">↔ {degree.get(item.id)} 条关联</div>}
              </a>
            ))}
          </div>
        </section>
      ))}
      <div class="empty" id="empty">当前筛选没有匹配的文章。</div>
      <footer>
        本站由 projection manifest 确定性构建：只包含通过发布门禁的内容，构建链含三段泄露扫描与闭包校验。<br/>
        「N+M」= 显式 related 双链 + 同标签软关联（图谱同源）。全文搜索在任意文章页右上角（Pagefind 索引）。
      </footer>
    </div>
    <script type="application/json" id="filter-data" set:html={filterData} />
    <script>
      // 标签面过滤：单选标签，隐藏不含该标签的卡片与空分组
      const tags = new Set();
      const bar = document.getElementById('tagbar');
      const clearBtn = document.getElementById('tag-clear');
      const empty = document.getElementById('empty');
      bar.addEventListener('click', (ev) => {
        const btn = ev.target.closest('.tag');
        if (!btn) return;
        const tag = btn.dataset.tag;
        if (tags.has(tag)) { tags.delete(tag); btn.classList.remove('active'); }
        else { tags.add(tag); btn.classList.add('active'); }
        apply();
      });
      clearBtn.addEventListener('click', () => { tags.clear();
        bar.querySelectorAll('.tag.active').forEach((b) => b.classList.remove('active')); apply(); });
      function apply() {
        clearBtn.style.display = tags.size ? 'inline' : 'none';
        let visible = 0;
        for (const card of document.querySelectorAll('a.card')) {
          const ok = [...tags].every((t) => (card.dataset.tags || '').split(' ').includes(t));
          card.classList.toggle('hide', !ok);
          if (ok) visible++;
        }
        for (const sec of document.querySelectorAll('section')) {
          const any = sec.querySelectorAll('a.card:not(.hide)').length > 0;
          sec.classList.toggle('hidden', !any);
        }
        empty.style.display = visible ? 'none' : 'block';
      }
    </script>
  </body>
</html>
